frpctl_edit_distance() {
  python3 - "$1" "$2" <<'PY'
import sys
a, b = sys.argv[1], sys.argv[2]
la, lb = len(a), len(b)
if abs(la - lb) > 3:
    print(99)
    raise SystemExit(0)
prev = list(range(lb + 1))
for i, ca in enumerate(a, 1):
    cur = [i]
    for j, cb in enumerate(b, 1):
        ins, delete, sub = cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + (ca != cb)
        cur.append(min(ins, delete, sub))
    prev = cur
print(prev[-1])
PY
}

frpctl_suggest() {
  local unknown="$1"
  local cmd dist
  local -a suggestions=()
  [[ -n "$unknown" ]] || return 0
  while IFS= read -r cmd; do
    [[ -n "$cmd" ]] || continue
    [[ "$cmd" != "?" ]] || continue
    if [[ ${#unknown} -ge 3 && "$cmd" == "$unknown"* ]]; then
      suggestions+=("$cmd")
      continue
    fi
    if [[ ${#cmd} -ge 3 && "$unknown" == "$cmd"* ]]; then
      suggestions+=("$cmd")
      continue
    fi
    dist="$(frpctl_edit_distance "$unknown" "$cmd" 2>/dev/null || echo 99)"
    if [[ "$dist" =~ ^[0-9]+$ ]] && [[ "$dist" -ge 1 && "$dist" -le 2 ]]; then
      suggestions+=("$cmd")
    fi
  done < <(frpctl_known_commands | sort -u)
  if [[ ${#suggestions[@]} -eq 0 ]]; then
    return 0
  fi
  echo "Did you mean:"
  local seen="" s
  for s in "${suggestions[@]}"; do
    case " $seen " in
      *" $s "*) continue ;;
    esac
    echo "  $s"
    seen="${seen} ${s}"
  done
  echo
}

frpctl_unknown_command() {
