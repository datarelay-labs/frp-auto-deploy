#!/usr/bin/env python3
import argparse
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
CFG = Path(ROOT + '/etc/frp-auto-deploy/config.json')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()


parser = argparse.ArgumentParser(description='List registered clients')
parser.add_argument(
    '--tag',
    action='append',
    default=[],
    metavar='KEY=VALUE',
    help='show clients with this tag; multiple --tag filters use AND semantics',
)
parser.add_argument(
    '--group',
    default=None,
    metavar='GROUP',
    help='show clients in this group (manual, dynamic, all, or ungrouped)',
)
parser.add_argument(
    '--status',
    default=None,
    choices=('online', 'offline', 'unknown'),
    help=(
        'filter by local published-port observation '
        '(not authoritative client/tunnel reachability)'
    ),
)
parser.add_argument(
    '--stale',
    action='store_true',
    help='show management-stale clients only (LAST MGMT SEEN threshold)',
)
parser.add_argument(
    '--build-drift',
    action='store_true',
    help='show clients with build drift vs server expected build',
)
parser.add_argument(
    '--last-mgmt-before',
    metavar='DURATION',
    help='show clients whose LAST MGMT SEEN is older than DURATION (e.g. 30d)',
)
args = parser.parse_args()
tag_filters = []
try:
    tag_filters = [CREG.parse_tag_assignment(value) for value in args.tag]
except ValueError as exc:
    parser.error(str(exc))


def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        version = 1
        if isinstance(state, dict) and 'schema_version' in state:
            version = state.get('schema_version')
        raise SystemExit(
            f'ERROR: unsupported registry schema version {version}.\n\n'
            'This release requires registry schema version 2.\n\n'
            'Back up the existing registry and redeploy/reset it explicitly before continuing.'
        )
    for client in (state.get('clients') or {}).values():
        if not isinstance(client, dict):
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'This release requires registry schema version 2.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )
        if 'ssh_port' in client or 'https_port' in client:
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'Legacy SSH/HTTPS fields are present. This release requires the generic multi-service registry.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )


def require_valid_registry(state, cfg=None):
    require_v2(state)
    try:
        CREG.validate_registry_or_raise(state, cfg)
    except ValueError as exc:
        raise SystemExit('ERROR: %s' % exc)


def client_state(services, snapshot):
    states = []
    for _sid, svc in services:
        states.append(CREG.passive_port_state(svc.get('remote_port'), snapshot))
    if 'online' in states:
        return 'online'
    if states and all(state == 'offline' for state in states):
        return 'offline'
    return 'unknown'


cfg = json.loads(CFG.read_text())
reg = Path(cfg['registry_file'])
if ROOT and not str(reg).startswith(ROOT):
    reg = Path(ROOT + str(reg))
state = json.loads(reg.read_text()) if reg.exists() else {'schema_version': 2, 'clients': {}}
require_valid_registry(state, cfg)

stale_sec = 30 * 86400
try:
    stale_sec = int(cfg.get('client_stale_days', 30)) * 86400
except (TypeError, ValueError):
    stale_sec = 30 * 86400
if args.last_mgmt_before:
    try:
        stale_sec = CREG.parse_duration(args.last_mgmt_before)
    except ValueError as exc:
        parser.error(str(exc))
expected = CREG.load_server_version_metadata(ROOT or None)

public_ip = CREG.sanitize_display(cfg.get('public_host') or cfg.get('public_ip') or '', 253)
# Short IDs must be unique across the full registry, not just the filtered view.
all_registry_mids = [mid for mid, _client in CREG.sorted_clients(state)]
clients = CREG.sorted_clients(state)
if tag_filters:
    clients = [
        (mid, client)
        for mid, client in clients
        if CREG.client_matches_tags(client, tag_filters)
    ]
if args.group:
    try:
        gid, _group = CREG.resolve_group(state, args.group)
    except CREG.GroupLookupError as exc:
        if exc.matches:
            sys.stderr.write('ERROR: multiple groups matched.\n\n')
            sys.stderr.write(CREG.format_group_candidate_table(exc.matches))
            sys.stderr.write('\nUse an immutable GROUP ID.\n')
        elif str(exc) == 'group not found':
            sys.stderr.write('ERROR: group not found: %s\n' % CREG.sanitize_display(args.group, 128))
        else:
            sys.stderr.write('ERROR: %s\n' % exc)
        raise SystemExit(1)
    clients = [
        (mid, client)
        for mid, client in clients
        if CREG.client_matches_group_selector(state, client, gid)
    ]
if args.stale or args.last_mgmt_before:
    clients = [
        (mid, client)
        for mid, client in clients
        if CREG.mgmt_activity_class(client, stale_sec) == 'stale'
    ]
if args.build_drift:
    clients = [
        (mid, client)
        for mid, client in clients
        if CREG.build_drift_class(client, expected) == 'drift'
    ]
listener_snapshot = CREG.passive_listening_ports()
if args.status:
    want = args.status
    clients = [
        (mid, client)
        for mid, client in clients
        if client_state(CREG.enabled_services(client), listener_snapshot) == want
    ]

title = 'Registered clients'
if args.stale or args.last_mgmt_before:
    title = 'Management-stale clients'
elif args.build_drift:
    title = 'Build-drift clients'

print(title)
print('=' * len(title))
print()
print(
    f'{"#":<3} {"CLIENT ID":<10} {"LABEL":<12} {"HOSTNAME":<14} '
    f'{"SERVICES":<8} {"STATE":<8} {"MGMT":<10} SSH'
)
print('-' * 104)

if not clients:
    print('(none)')

for idx, (mid, client) in enumerate(clients, start=1):
    services = CREG.enabled_services(client)
    label = CREG.sanitize_display(client.get('label') or '-', 12)
    hostname = CREG.sanitize_display(client.get('hostname') or '-', 14)
    short_id = CREG.sanitize_display(CREG.unique_short_id(mid, all_registry_mids), 10)
    state_txt = client_state(services, listener_snapshot)
    mgmt = CREG.mgmt_activity_class(client, stale_sec)
    if mgmt == 'revoked':
        mgmt_txt = 'revoked'
    elif mgmt == 'recent':
        mgmt_txt = 'recent'
    elif mgmt == 'stale':
        mgmt_txt = 'stale'
    else:
        mgmt_txt = 'unknown'
    ssh_txt = '-'
    _sid, ssh = CREG.first_ssh_service(client)
    if ssh:
        user = CREG.ssh_user_display(ssh)
        port = ssh.get('remote_port') or '-'
        if ssh.get('ssh_user'):
            ssh_txt = '%s@%s:%s' % (user, public_ip or 'host', port)
        else:
            ssh_txt = 'legacy / unspecified'
        ssh_txt = CREG.sanitize_display(ssh_txt, 48)
    print(
        f'{idx:<3} {short_id:<10} {label:<12} {hostname:<14} '
        f'{str(len(services)):<8} {state_txt:<8} {mgmt_txt:<10} {ssh_txt}'
    )

print()
print('Use CLIENT ID for set/unset/revoke/release.')
print('MGMT = management activity (LAST MGMT SEEN), not FRP tunnel state.')
print('STATE = local published-port observation, not authoritative tunnel reachability.')
print('A unique label or hostname is accepted for show/info only.')
if clients:
    example = CREG.sanitize_display(CREG.unique_short_id(clients[0][0], all_registry_mids), 16)
    if example:
        print()
        print('Example:')
        print('  show client %s' % example)

if clients:
    print()
    for mid, client in clients:
        name = CREG.sanitize_display(CREG.display_name(client, mid), 64)
        print(name)
        services = client.get('services') or {}
        if not isinstance(services, dict) or not services:
            print('  (no services)')
            continue
        for sid, svc in sorted(
            services.items(),
            key=lambda kv: (kv[1].get('remote_port') or 0, kv[0]) if isinstance(kv[1], dict) else (0, kv[0]),
        ):
            if not isinstance(svc, dict):
                continue
            port = svc.get('remote_port') or '-'
            suffix = '' if svc.get('enabled', True) else ' (reserved)'
            print(f'  {CREG.sanitize_display(sid, 32)}:{port}{suffix}')
        print()
