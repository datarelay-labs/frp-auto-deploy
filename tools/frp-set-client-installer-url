#!/usr/bin/env python3
import json, os, sys, tempfile
from pathlib import Path

if len(sys.argv)!=2:
    print(f'Usage: {sys.argv[0]} <raw-install-client-url>', file=sys.stderr); sys.exit(2)
path=Path(os.environ.get('FRP_DEPLOY_TEST_ROOT', '') + '/etc/frp-auto-deploy/config.json')
cfg=json.loads(path.read_text())
cfg['client_installer_url']=sys.argv[1]
fd,tmp=tempfile.mkstemp(prefix='config.',suffix='.tmp',dir=str(path.parent))
with os.fdopen(fd,'w') as f:
    json.dump(cfg,f,indent=2,sort_keys=True); f.write('\n'); f.flush(); os.fsync(f.fileno())
os.chmod(tmp,0o600); os.replace(tmp,path)
print('Client installer URL updated.')
