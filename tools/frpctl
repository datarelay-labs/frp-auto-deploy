  local client=0 server=0
  frpctl_is_client && client=1
  frpctl_is_server && server=1
  echo
  if [[ "$client" == "1" && "$server" == "1" ]]; then
    echo "FRP Auto Deploy — Commands"
    echo "=========================="
    echo
    echo "This host has both an FRP client and an FRP server installed."
    echo
    echo "Client commands"
    echo "---------------"
    echo "  services              List configured services"
    echo "  manage                Add/edit/enable/disable services"
    echo "  info                  Show connection information"
    echo
    echo "Server commands"
    echo "---------------"
