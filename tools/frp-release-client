#!/usr/bin/env python3
import argparse
import fcntl
import importlib.util
import json
import os
import tempfile
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()


def lock_registry(path):
    lock_path = Path(path).resolve().parent / 'registry.lock'
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def unlock_registry(fd):
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def atomic_write_json(path, data, mode=0o600):
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        version = 1
        if isinstance(state, dict) and 'schema_version' in state:
            version = state.get('schema_version')
        raise SystemExit(
            f'ERROR: unsupported registry schema version {version}.\n\n'
            'This release requires registry schema version 2.\n\n'
            'Back up the existing registry and redeploy/reset it explicitly before continuing.'
        )
    for client in (state.get('clients') or {}).values():
        if not isinstance(client, dict):
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'This release requires registry schema version 2.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )
        if 'ssh_port' in client or 'https_port' in client:
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'Legacy SSH/HTTPS fields are present. This release requires the generic multi-service registry.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )


parser = argparse.ArgumentParser(description='Release a client record and its reserved ports')
parser.add_argument('query', help='label, unique hostname, or machine-id prefix')
parser.add_argument('--force', action='store_true', help='release even if a published port is currently active')
args = parser.parse_args()


def ensure_releasable(services, force=False):
    snapshot = CREG.passive_listening_ports()
    states = [
        CREG.passive_port_state(service.get('remote_port'), snapshot)
        for service in services.values() if isinstance(service, dict) and service.get('remote_port')
    ]
    if any(state != 'offline' for state in states) and not force:
        raise SystemExit(
            'Client state is %s. Uninstall/stop frpc first, or use --force.'
            % ('online' if 'online' in states else 'unknown')
        )


cfg = json.loads(Path(ROOT + '/etc/frp-auto-deploy/config.json').read_text())
path = Path(cfg['registry_file'])
if ROOT and not str(path).startswith(ROOT):
    path = Path(ROOT + str(path))
state = json.loads(path.read_text())
require_v2(state)

mid, client = CREG.resolve_client_or_exit(state, args.query)

services = client.get('services') or {}
if not isinstance(services, dict):
    services = {}
ports = []
for sid, svc in sorted(services.items()):
    if not isinstance(svc, dict):
        continue
    port = svc.get('remote_port')
    if port:
        ports.append((sid, int(port), svc.get('enabled', True) is not False))

ensure_releasable(services, args.force)

print(f'Releasing {CREG.sanitize_display(CREG.display_name(client, mid), 64)} '
      f'({CREG.sanitize_display(mid, 128)})')
if ports:
    print('Services:')
    for sid, port, enabled in ports:
        suffix = '' if enabled else ' (reserved)'
        print(f'  {CREG.sanitize_display(sid, 32)}: {port}{suffix}')
else:
    print('Services: (none)')
answer = input('Type RELEASE to continue: ')
if answer != 'RELEASE':
    raise SystemExit('Cancelled')

lock_fd = lock_registry(path)
try:
    state = json.loads(path.read_text())
    require_v2(state)
    mid, client = CREG.resolve_client_or_exit(state, args.query)
    services = client.get('services') or {}
    if not isinstance(services, dict):
        services = {}
    # Re-check under the registry lock to close the TOCTOU window.
    ensure_releasable(services, args.force)
    state['clients'].pop(mid)
    atomic_write_json(path, state)
finally:
    unlock_registry(lock_fd)
print('Released.')
