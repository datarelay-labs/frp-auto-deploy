#!/usr/bin/env bash
# Unified operator entry point for frp-auto-deploy.
# Thin dispatcher over existing commands. Does not reimplement registry or
# client-state mutations.
set -euo pipefail

_FRPCTL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_FRP_CTL_SESSION_HIST=()
_FRP_CTL_RC=0

frpctl_path() {
  local p="$1"
  local root="${FRP_CTL_TEST_ROOT:-${FRP_CLIENT_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-${FRP_UPDATE_ROOT:-}}}}"
  # Canonical Linux FHS paths are rewritten onto the platform layout first
  # (identity on Linux), then optionally remapped under a test root.
  if declare -F frp_platform_map_path >/dev/null 2>&1; then
    p="$(frp_platform_map_path "$p")"
  fi
  if [[ -n "$root" ]]; then
    printf '%s' "${root}${p}"
  else
    printf '%s' "$p"
  fi
}

# Prefer remapped installed libdir under FRP_*_TEST_ROOT, then checkout, then
# the live /usr/local install. Never rely on a developer /home/... path.
frpctl_installed_libdir() {
  local cand
  cand="$(frpctl_path /usr/local/lib/frp-auto-deploy)"
  if [[ -d "$cand" ]]; then
    printf '%s' "$cand"
    return 0
  fi
  # Production macOS layout before frp_platform_map_path is available.
  cand="${FRP_MACOS_STATE_ROOT:-/Library/Application Support/frp-auto-deploy}/lib"
  if [[ -d "$cand" ]]; then
    printf '%s' "$cand"
    return 0
  fi
  if [[ -d /usr/local/lib/frp-auto-deploy ]]; then
    printf '%s' /usr/local/lib/frp-auto-deploy
    return 0
  fi
  return 1
}

_frpctl_source_lib() {
  local name="$1"
  local cand
  # Development checkout: tools/frpctl → ../lib/
  if [[ -f "${_FRPCTL_DIR}/../lib/${name}" ]]; then
    # shellcheck disable=SC1090
    . "${_FRPCTL_DIR}/../lib/${name}"
    return 0
  fi
  if cand="$(frpctl_installed_libdir)" && [[ -f "${cand}/${name}" ]]; then
    # shellcheck disable=SC1090
    . "${cand}/${name}"
    return 0
  fi
  return 1
}

_frpctl_source_lib frp-doctor-common.sh || true
_frpctl_source_lib frp-client-lifecycle.sh || true

frpctl_is_client() {
  if [[ -f "$(frpctl_path /etc/frp/client-state.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/frpc.toml)" && -f "$(frpctl_path /etc/frp/client-identity.key)" ]]; then
    return 0
  fi
  return 1
}

frpctl_is_server() {
  if [[ -f "$(frpctl_path /etc/frp-auto-deploy/config.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/server_token)" && -f "$(frpctl_path /var/lib/frp-auto-deploy/registry.json)" ]]; then
    return 0
  fi
  return 1
}

frpctl_python_lib() {
  local cand
  if [[ -f "${_FRPCTL_DIR}/../lib/frp_fleet.py" ]]; then
    printf '%s' "${_FRPCTL_DIR}/../lib"
    return 0
  fi
  if cand="$(frpctl_installed_libdir)" && [[ -f "${cand}/frp_fleet.py" || -d "$cand" ]]; then
    printf '%s' "$cand"
    return 0
  fi
  printf '%s' "${_FRPCTL_DIR}/../lib"
}

frpctl_server_lifecycle_dispatch() {
  local cmd="${1:-}"
  local libdir
  libdir="$(frpctl_python_lib)"
  shift || true
  PYTHONPATH="${libdir}${PYTHONPATH:+:$PYTHONPATH}" \
    FRP_DEPLOY_TEST_ROOT="${FRP_DEPLOY_TEST_ROOT:-${FRP_CTL_TEST_ROOT:-}}" \
    FRP_CTL_TEST_ROOT="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}" \
    FRP_SKIP_SYSTEMD="${FRP_SKIP_SYSTEMD:-}" \
    python3 "${libdir}/frp_server_lifecycle.py" "$cmd" "$@"
}

frpctl_show_fleet() {
  local libdir
