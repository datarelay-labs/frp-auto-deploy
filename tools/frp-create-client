def run_enrollment_retention_cleanup(cfg):
    lifecycle = load_enrollment_lifecycle()
    if lifecycle is None:
        return
    try:
        cleanup_cfg = dict(cfg)
        cleanup_cfg['enrollments_dir'] = str(remap(cfg['enrollments_dir']))
        cleanup_cfg['bootstrap_dir'] = str(
            remap(cfg.get('bootstrap_dir') or str(Path(cfg['enrollments_dir']).parent / 'bootstrap'))
        )
        cleanup_cfg['registry_file'] = str(
            remap(cfg.get('registry_file') or str(Path(cfg['enrollments_dir']).parent / 'registry.json'))
        )
        lifecycle.maybe_run_retention_cleanup(
            cleanup_cfg,
            force=True,
            audit_emit=lifecycle.load_audit_emit(),
        )
    except Exception:
        return


