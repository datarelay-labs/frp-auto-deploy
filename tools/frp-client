#!/usr/bin/env bash
set -euo pipefail

frp_client_source_lib() {
  local here cand
  if [[ -n "${FRP_CLIENT_LIB:-}" && -f "${FRP_CLIENT_LIB}" ]]; then
    # shellcheck source=lib/frp-client-common.sh
    . "${FRP_CLIENT_LIB}"
    return 0
  fi
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for cand in \
    "$here/lib/frp-client-common.sh" \
    "$here/../lib/frp-client-common.sh" \
    /usr/local/lib/frp-auto-deploy/frp-client-common.sh
  do
    if [[ -f "$cand" ]]; then
      # shellcheck source=lib/frp-client-common.sh
      . "$cand"
      return 0
    fi
  done
  echo "ERROR: missing frp-client-common.sh" >&2
  exit 1
}

frp_client_source_lib

frp_state_add_payload() {
  python3 - "$CANDIDATE_FILE" "$1" <<'PY'
import json, re, sys
from pathlib import Path
path = Path(sys.argv[1])
raw = json.loads(sys.argv[2])
state = json.loads(path.read_text(encoding='utf-8'))
services = state.setdefault('services', {})
sid = str(raw.get('id', '')).strip().lower()
if not re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,31}', sid or ''):
    raise SystemExit('ERROR: invalid service id; use [a-z0-9][a-z0-9._-]{0,31}')
if sid in services:
    raise SystemExit(
        f'ERROR: duplicate service id: {sid}\n\n'
        'A service with this ID already exists.\n'
        'Service IDs are lowercase and case-insensitive.'
    )
protocol = str(raw.get('protocol', 'tcp') or 'tcp').strip().lower()
if protocol != 'tcp':
    raise SystemExit('ERROR: only tcp services are supported')
preset = str(raw.get('preset', 'custom') or 'custom').strip().lower()
if preset not in ('ssh', 'http', 'https', 'custom'):
    raise SystemExit('ERROR: invalid service preset')
name = str(raw.get('name', '') or sid).strip() or sid
if len(name) > 64 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in name):
    raise SystemExit('ERROR: invalid service display name')
local_ip = str(raw.get('local_ip', '')).strip()
if (not local_ip or len(local_ip) > 253
        or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in local_ip)
        or any(c in local_ip for c in ' /\\;|&$`\'"<>')):
    raise SystemExit('ERROR: invalid target host')
try:
    local_port = int(str(raw.get('local_port', '')).strip())
except Exception:
    raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
if local_port < 1 or local_port > 65535:
    raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
if len(services) >= 32:
    raise SystemExit('ERROR: too many services')
item = {
    'id': sid,
    'name': name,
    'protocol': 'tcp',
    'local_ip': local_ip,
    'local_port': local_port,
    'preset': preset,
    'enabled': True,
}
if preset == 'ssh':
    ssh_user = str(raw.get('ssh_user', '') or '').strip()
    if not ssh_user:
        raise SystemExit('ERROR: ssh_user is required for ssh services')
    if not re.fullmatch(r'[A-Za-z0-9._@-]{1,32}', ssh_user):
        raise SystemExit('ERROR: invalid ssh_user')
    item['ssh_user'] = ssh_user
services[sid] = item
path.write_text(json.dumps(state, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
}

frp_require_root() {
  if [[ ${EUID} -ne 0 && -z "${FRP_CLIENT_TEST_ROOT:-}" ]]; then
    echo "ERROR: run as root, e.g. sudo frp-client" >&2
    exit 1
  fi
}

frp_client_update_cmd() {
  local source="${FRP_CLIENT_UPDATE_SOURCE:-}"
  local check_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source)
        source="${2:-}"
        shift 2
        ;;
      --check|--dry-run)
        check_only=1
        shift
        ;;
      -h|--help)
        cat <<'EOF'
Usage: frp-client update [--source DIR] [--check]

Upgrade this client's frp-auto-deploy management tools.

  --source DIR   use a local source tree instead of downloading the bundle
  --check        report installed/target versions without changing files

This updates project tools only. It does not require an Enrollment Code,
does not regenerate management identity, and does not rewrite client
state, frpc.toml, or public port assignments. The official frpc binary
is left unchanged when it is already the tested version.

The recommended command is: sudo frpctl update
EOF
        return 0
        ;;
      *)
        echo "ERROR: unknown option: $1" >&2
        echo "Usage: frp-client update [--source DIR] [--check]" >&2
        return 2
        ;;
    esac
  done
  frp_client_fetch_and_upgrade "$source" "$check_only"
}

frp_copy_state() {
  python3 - "$1" "$2" <<'PY'
import json, sys
from pathlib import Path
src, dest = Path(sys.argv[1]), Path(sys.argv[2])
data = json.loads(src.read_text(encoding='utf-8'))
dest.write_text(json.dumps(data, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
}

frp_client_status() {
  local path
  path="$(frp_client_state_path)"
  frp_load_client_state "$path"
  python3 - "$path" "$(frp_client_installed_frp_version)" "${FRP_CLIENT_TEST_ROOT:-}" "${FRP_SKIP_SYSTEMD:-}" "$(frp_identity_label)" "$(frp_client_installed_project_version)" "$(frp_client_installed_release_channel)" "$(frp_client_installed_source_ref)" "$(frp_client_installed_bundle_sha256)" <<'PY'
import json, subprocess, sys
from pathlib import Path
data = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
tested = sys.argv[2]
test_root = sys.argv[3]
skip_systemd = sys.argv[4]
project_version = sys.argv[6]
release_channel = sys.argv[7]
source_ref = sys.argv[8]
bundle_sha256 = sys.argv[9]
services = data.get('services') or {}
enabled = sum(1 for s in services.values() if s.get('enabled', True) is not False)
disabled = len(services) - enabled
active = 'unknown'
if test_root or skip_systemd == '1':
    active = 'test'
else:
    try:
        r = subprocess.run(['systemctl', 'is-active', 'frpc'], capture_output=True, text=True, timeout=3)
        active = (r.stdout or r.stderr or 'unknown').strip() or 'unknown'
    except Exception:
        active = 'unknown'
allocator = 'configured' if data.get('allocator_url') else 'missing'
print('FRP Client')
print('==========')
print()
print(f"Role            : Client")
print(f"Project version : {project_version}")
print(f"Release channel : {release_channel}")
print(f"Source ref      : {source_ref}")
print(f"Hostname        : {data.get('hostname', '')}")
print(f"FRP server      : {data.get('frp_server', '')}:{data.get('frp_server_port', '')}")
print(f"Allocator       : {allocator}")
print(f"Management identity : {sys.argv[5]}")
print(f"FRP version     : {tested}")
print(f"Bundle SHA256   : {bundle_sha256}")
print(f"frpc            : {active}")
print()
print(f"Services        : {enabled} enabled / {disabled} disabled")
print()
for sid, item in services.items():
    state = 'enabled' if item.get('enabled', True) is not False else 'disabled'
    print(item.get('id') or sid)
    if item.get('local_ip') is not None:
        print(f"  target        : {item.get('local_ip')}:{item.get('local_port')}")
    if item.get('remote_port') is not None:
        print(f"  public port   : {item.get('remote_port')}")
    print(f"  state         : {state}")
    print()
PY
  frp_lifecycle_report
  pending="$(frp_client_pending_path)"
  if [[ -f "$pending" ]]; then
    python3 - "$pending" <<'PY'
import json, sys
from pathlib import Path
try:
    data = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
fail = data.get('failure_class') or data.get('FAILURE_CLASS') or ''
if fail:
    print(f"Last failure      : {fail}")
    print("Recovery required : yes")
PY
  fi
}

frp_client_info() {
  local access
  access="$(frp_client_access_path)"
  if [[ -f "$access" ]]; then
    cat "$access"
    return 0
  fi
  local path
  path="$(frp_client_state_path)"
  if [[ ! -f "$path" ]]; then
    echo "ERROR: This client predates local management state." >&2
    echo "Re-enroll once with the current bootstrap installer to initialize frp-client management." >&2
    return 1
  fi
  frp_load_client_state "$path"
  python3 - "$path" <<'PY'
import json, sys
from pathlib import Path
data = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
def clean(value, limit=253):
    text = str(value or '')
    return ''.join(' ' if ord(c) < 32 or 127 <= ord(c) <= 159 else c for c in text)[:limit].strip()
server = clean(data.get('frp_server', ''))
print(f'FRP Server: {server}')
print()
print('Services:')
print()
for sid, item in (data.get('services') or {}).items():
    if item.get('enabled', True) is False:
        continue
    sid = clean(sid, 32)
    name = clean(item.get('name') or sid, 64)
    remote = item.get('remote_port')
    print(sid if name == sid else f'{sid} ({name})')
    print(f"  Target : {clean(item.get('local_ip'))}:{item.get('local_port')}")
    print(f"  Public : {server}:{remote}")
    preset = item.get('preset') or 'custom'
    if preset == 'ssh':
        user = clean(item.get('ssh_user'), 32)
        if user:
            print('  Connect:')
            print(f"    ssh -p {remote} {user}@{server}")
        else:
            print('  SSH user: legacy / unspecified')
    elif preset == 'http':
        print('  URL:')
        print(f'    http://{server}:{remote}')
    elif preset == 'https':
        print('  URL:')
        print(f'    https://{server}:{remote}')
    else:
        print('  Connect:')
        print(f'    {server}:{remote}')
    print()
PY
}

frp_client_list() {
  local path
  path="$(frp_client_state_path)"
  frp_load_client_state "$path"
  frp_print_state_services "$path"
}

frp_select_service_id() {
  python3 - "$CANDIDATE_FILE" "$1" <<'PY'
import json, sys
from pathlib import Path
state = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
services = list((state.get('services') or {}).items())
try:
    idx = int(sys.argv[2])
except Exception:
    raise SystemExit('ERROR: invalid service number')
if idx < 1 or idx > len(services):
    raise SystemExit('ERROR: service number out of range')
print(services[idx-1][0])
PY
}

menu_add_service() {
  local payload=""
  frp_ux_prompt_new_service payload
  if [[ -z "$payload" ]]; then
    return 0
  fi
  if ! frp_state_add_payload "$payload"; then
    return 0
  fi
}

menu_edit_service() {
  local choice sid name host port user
  echo
  echo "Current services:"
  echo
  frp_print_state_services "$CANDIDATE_FILE"
  choice="$(read_tty "Edit service number: " "")"
  if ! sid="$(frp_select_service_id "$choice")"; then
    return 0
  fi
  echo "Service ID ${sid} cannot be changed."
  echo "The Service ID plus this machine's identity keeps the public port stable."
  echo "To use a different ID, add a new service and disable this one."
  echo
  local meta old_name old_host old_port old_user preset
  meta="$(python3 - "$CANDIDATE_FILE" "$sid" <<'PY'
import json,sys
from pathlib import Path
item=json.loads(Path(sys.argv[1]).read_text())['services'][sys.argv[2]]
print(item.get('name',''))
print(item.get('local_ip',''))
print(item.get('local_port',''))
print(item.get('ssh_user',''))
print(item.get('preset','custom'))
PY
)"
  old_name="$(printf '%s\n' "$meta" | sed -n '1p')"
  old_host="$(printf '%s\n' "$meta" | sed -n '2p')"
  old_port="$(printf '%s\n' "$meta" | sed -n '3p')"
  old_user="$(printf '%s\n' "$meta" | sed -n '4p')"
  preset="$(printf '%s\n' "$meta" | sed -n '5p')"
  echo "Display name"
  echo "  Label shown in status and connection information."
  echo
  name="$(read_tty "Display name [${old_name}]: " "$old_name")"
  frp_ux_target_host_help
  host="$(read_tty "Target host [${old_host}]: " "$old_host")"
  frp_ux_target_port_help "$preset"
  port="$(read_tty "Target port [${old_port}]: " "$old_port")"
  user="$old_user"
  if [[ "$preset" == ssh ]]; then
    frp_prompt_ssh_user user "$old_user"
  fi
  maybe_warn_connectivity "$host" "$port" "TCP"
  if ! python3 - "$CANDIDATE_FILE" "$sid" "$name" "$host" "$port" "$user" <<'PY'
import json, re, sys
from pathlib import Path
path = Path(sys.argv[1])
sid, name, host, port, user = sys.argv[2:7]
state = json.loads(path.read_text(encoding='utf-8'))
item = state['services'][sid]
if len(name) > 64 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in name):
    raise SystemExit('ERROR: invalid service display name')
if (not host or len(host) > 253
        or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in host)
        or any(c in host for c in ' /\\;|&$`\'"<>')):
    raise SystemExit('ERROR: invalid target host')
try:
    local_port = int(port)
except Exception:
    raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
if local_port < 1 or local_port > 65535:
    raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
item['name'] = name.strip() or sid
item['local_ip'] = host
item['local_port'] = local_port
if item.get('preset') == 'ssh':
    if not str(user or '').strip():
        raise SystemExit('ERROR: ssh_user is required for ssh services')
    if not re.fullmatch(r'[A-Za-z0-9._@-]{1,32}', user):
        raise SystemExit('ERROR: invalid ssh_user')
    item['ssh_user'] = user
path.write_text(json.dumps(state, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
  then
    return 0
  fi
}

menu_enable_disable() {
  local choice sid
  echo
  echo "Current services:"
  echo
  frp_print_state_services "$CANDIDATE_FILE"
  choice="$(read_tty "Service number: " "")"
  if ! sid="$(frp_select_service_id "$choice")"; then
    return 0
  fi
  if ! python3 - "$CANDIDATE_FILE" "$sid" <<'PY'
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
sid = sys.argv[2]
state = json.loads(path.read_text(encoding='utf-8'))
item = state['services'][sid]
currently = item.get('enabled', True) is not False
if currently:
    enabled_count = sum(1 for rec in state['services'].values() if rec.get('enabled', True) is not False)
    if enabled_count <= 1:
        raise SystemExit('ERROR: at least one enabled service is required.')
    item['enabled'] = False
    print(f"Service {sid} will be disabled.")
    print('The server-side public port reservation will remain.')
else:
    item['enabled'] = True
    print(f"Service {sid} will be re-enabled.")
path.write_text(json.dumps(state, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
  then
    return 0
  fi
}

frp_apply_candidate() {
  local current candidate
  current="$(frp_client_state_path)"
  candidate="$CANDIDATE_FILE"
  if [[ -f "$current" ]]; then
    if [[ ! -f "$(frp_client_access_path)" ]]; then
      frp_regenerate_access_from_state || true
    fi
    if [[ ! -f "$(frp_client_toml_path)" ]]; then
      local rec_token="" rec_backup=""
      rec_backup="$(frp_latest_backup_dir || true)"
      if [[ -n "$rec_backup" && -f "$rec_backup/frpc.toml" ]]; then
        rec_token="$(frp_token_from_toml_file "$rec_backup/frpc.toml" || true)"
      fi
      if [[ -n "$rec_token" ]]; then
        frp_regenerate_toml_from_state "$rec_token" || true
      fi
    fi
    if [[ -f "$(frp_client_pending_path)" ]] && frp_artifacts_consistent; then
      frp_pending_clear
    fi
  fi
  if frp_state_has_diff "$current" "$candidate"; then
    echo "No pending changes."
    return 0
  fi
  if [[ "$(frp_count_enabled_services "$candidate")" == "0" ]]; then
    echo "ERROR: at least one enabled service is required." >&2
    return 1
  fi

  echo
  frp_state_diff "$current" "$candidate" || true
  frp_ux_print_apply_summary "$current" "$candidate"

  local change_class ident_status auth_mode="enrollment"
  change_class="$(frp_state_change_class "$current" "$candidate")"
  ident_status="$(frp_identity_status)"
  if [[ "$change_class" == runtime ]]; then
    if [[ "$ident_status" == enrolled ]]; then
      echo "Authentication: existing client identity"
    elif [[ "$ident_status" == corrupt ]]; then
      echo "ERROR: this client's management identity is unusable." >&2
      echo "Create a new Enrollment Code on the FRP server with sudo frp-create-client," >&2
      echo "then re-enroll this client. Do not overwrite the damaged identity file automatically." >&2
      return 1
    else
      echo "This is an existing client without a management identity."
      echo "A one-time Enrollment Code is required to establish trust."
      echo "Future configuration changes will not require an Enrollment Code."
      echo "Authentication: one-time Enrollment Code"
    fi
    echo
  fi
  if [[ -z "${FRP_CLIENT_CANDIDATE:-}" ]]; then
    if ! frp_confirm_yes "Continue? [Y/n]: "; then
      echo "Apply cancelled."
      return 0
    fi
  fi

  if [[ "$change_class" == local ]]; then
    frp_apply_local_metadata "$current" "$candidate"
    return $?
  fi

  if ! frp_lifecycle_recover; then
    if [[ ! -f "$(frp_client_toml_path)" ]] && [[ "$(frp_identity_status)" == enrolled ]]; then
      echo "ERROR: local runtime configuration is incomplete and cannot be repaired automatically." >&2
      frp_emit_failure_class RECOVERY_REQUIRED
      return 1
    fi
  fi

  local enroll_id="" enroll_secret=""
  if [[ "$ident_status" == enrolled ]]; then
    auth_mode="identity"
    echo
    echo "Authenticating client..."
  else
    echo
    frp_ux_enrollment_help
    prompt_secret "Enrollment Code: " FRP_ENROLLMENT_CODE
    if [[ "$FRP_ENROLLMENT_CODE" != *.* ]]; then
      echo "ERROR: invalid enrollment code format" >&2
      unset FRP_ENROLLMENT_CODE
      return 1
    fi
    enroll_id="${FRP_ENROLLMENT_CODE%%.*}"
    enroll_secret="${FRP_ENROLLMENT_CODE#*.}"
    unset FRP_ENROLLMENT_CODE
    if ! frp_identity_ensure; then
      return 1
    fi
    echo "Authenticating client..."
  fi
  echo "Applying configuration..."

  local work allocated meta token server port host_id machine_id hostname_value allocator_url
  local ciphertext backup local_rollback="N/A" server_rollback="N/A" restore_needed=0
  local operation_id
  operation_id="$(python3 - <<'PY'
import secrets
print(secrets.token_hex(16))
PY
)"
  export FRP_CLIENT_OPERATION_ID="$operation_id"
  work="$(mktemp -d)"
  allocated="$work/allocated.json"
  meta="$work/meta.json"
  frp_pending_write prepare "$operation_id" pending

  python3 - "$candidate" "$current" <<'PY'
import json,sys
from pathlib import Path
cand=json.loads(Path(sys.argv[1]).read_text())
cur=json.loads(Path(sys.argv[2]).read_text())
for key in ('allocator_url','frp_server','frp_server_port','hostname','machine_id','host_id'):
    cand.setdefault(key, cur.get(key))
Path(sys.argv[1]).write_text(json.dumps(cand, indent=2, sort_keys=True)+'\n', encoding='utf-8')
PY

  allocator_url="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["allocator_url"])' "$candidate")"
  machine_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["machine_id"])' "$candidate")"
  hostname_value="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["hostname"])' "$candidate")"
  host_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["host_id"])' "$candidate")"

  local enroll_rc=0
  frp_enroll_services "$allocator_url" "$enroll_id" "$enroll_secret" \
    "$machine_id" "$hostname_value" "$candidate" "$allocated" "$meta" "$auth_mode" \
    || enroll_rc=$?
  if [[ "$enroll_rc" -eq 2 && "$auth_mode" == identity ]]; then
    echo "ERROR: this client's management identity has been revoked." >&2
    echo "Run the server enrollment command to create a new Enrollment Code," >&2
    echo "then re-enroll this client." >&2
    if [[ -z "${FRP_ENROLLMENT_CODE:-}" && -n "${FRP_CLIENT_CANDIDATE:-}" ]]; then
      rm -rf "$work"
      unset enroll_secret
      return 1
    fi
    echo
    echo "A one-time Enrollment Code is required to re-establish trust."
    echo "Future configuration changes will not require an Enrollment Code."
    echo
    frp_ux_enrollment_help
    prompt_secret "Enrollment Code: " FRP_ENROLLMENT_CODE
    if [[ "$FRP_ENROLLMENT_CODE" != *.* ]]; then
      echo "ERROR: invalid enrollment code format" >&2
      unset FRP_ENROLLMENT_CODE
      rm -rf "$work"
      return 1
    fi
    enroll_id="${FRP_ENROLLMENT_CODE%%.*}"
    enroll_secret="${FRP_ENROLLMENT_CODE#*.}"
    unset FRP_ENROLLMENT_CODE
    auth_mode="enrollment"
    echo "Authenticating client..."
    echo "Applying configuration..."
    enroll_rc=0
    frp_enroll_services "$allocator_url" "$enroll_id" "$enroll_secret" \
      "$machine_id" "$hostname_value" "$candidate" "$allocated" "$meta" "$auth_mode" \
      || enroll_rc=$?
  fi
  if [[ "$enroll_rc" -ne 0 ]]; then
    rm -rf "$work"
    unset enroll_secret FRP_CLIENT_OPERATION_ID
    frp_pending_clear
    echo "ERROR: enrollment failed; local configuration was not changed." >&2
    frp_emit_failure_class SERVER_MUTATION_FAILED
    return 1
  fi
  if ! frp_client_test_hook AFTER_SERVER_MUTATION; then
    frp_pending_write server_mutation "$operation_id" ok
    rm -rf "$work"
    unset enroll_secret FRP_CLIENT_OPERATION_ID
    echo "ERROR: apply interrupted after the server accepted the change; local configuration was not changed." >&2
    echo "The server reservation is preserved. Retry Apply to reconcile." >&2
    frp_emit_failure_class FAILED_WITH_RESERVATION_PRESERVED
    echo "LOCAL_ROLLBACK=PASS"
    echo "SERVER_ROLLBACK=N/A"
    return 1
  fi
  frp_pending_write server_mutation "$operation_id" ok
  server="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["frp_server"])' "$meta")"
  port="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["frp_server_port"])' "$meta")"
  ciphertext="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("token_ciphertext") or "")' "$meta")"
  if [[ -n "$ciphertext" ]]; then
    if ! token="$(frp_decrypt_token "$ciphertext" "$enroll_secret")"; then
      echo "ERROR: token decryption failed; local configuration was not changed." >&2
      if frp_compensate_previous "$allocator_url" "$enroll_id" "$enroll_secret" \
        "$machine_id" "$hostname_value" "$current" "$auth_mode"; then
        server_rollback="PASS"
      else
        server_rollback="FAIL"
      fi
      rm -rf "$work"
      unset enroll_secret token FRP_CLIENT_OPERATION_ID
      echo "LOCAL_ROLLBACK=PASS"
      echo "SERVER_ROLLBACK=${server_rollback}"
      if [[ "$server_rollback" != "PASS" ]]; then
        echo "WARNING: server registry may not match local configuration. Reconcile with a new enrollment." >&2
        frp_emit_failure_class RECOVERY_REQUIRED
      else
        frp_pending_clear
        frp_emit_failure_class CONFIG_GENERATION_FAILED
      fi
      return 1
    fi
  else
    if ! token="$(frp_read_existing_token)"; then
      echo "ERROR: existing FRP client configuration is missing the FRP token; re-enroll this client." >&2
      if frp_compensate_previous "$allocator_url" "$enroll_id" "$enroll_secret" \
        "$machine_id" "$hostname_value" "$current" "$auth_mode"; then
        server_rollback="PASS"
      else
        server_rollback="FAIL"
      fi
      rm -rf "$work"
      unset enroll_secret
      echo "LOCAL_ROLLBACK=PASS"
      echo "SERVER_ROLLBACK=${server_rollback}"
      return 1
    fi
  fi

  python3 - "$candidate" "$server" "$port" "$meta" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])
s=json.loads(p.read_text())
s['frp_server']=sys.argv[2]
s['frp_server_port']=int(sys.argv[3])
meta=json.loads(Path(sys.argv[4]).read_text())
transport=str(meta.get('frp_transport') or s.get('frp_transport') or 'tcp').strip().lower() or 'tcp'
if transport not in ('tcp', 'wss'):
    raise SystemExit('ERROR: allocator returned an unsupported FRP transport')
s['frp_transport']=transport
p.write_text(json.dumps(s, indent=2, sort_keys=True)+'\n')
PY
  if ! frp_merge_ports_into_state "$candidate" "$allocated"; then
    echo "ERROR: allocator response could not be merged; local configuration was not changed." >&2
    frp_compensate_previous "$allocator_url" "$enroll_id" "$enroll_secret" \
      "$machine_id" "$hostname_value" "$current" "$auth_mode" || true
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    frp_emit_failure_class SERVER_MUTATION_FAILED
    return 1
  fi

  if ! frp_client_test_hook BEFORE_STATE_COMMIT; then
    echo "ERROR: apply stopped before local state commit; previous local configuration was kept." >&2
    echo "The server reservation is preserved. Retry Apply to reconcile." >&2
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    echo "LOCAL_ROLLBACK=PASS"
    echo "SERVER_ROLLBACK=N/A"
    frp_emit_failure_class FAILED_WITH_RESERVATION_PRESERVED
    return 1
  fi

  local tmp_toml tmp_access tmp_state enabled_list transport
  tmp_toml="$work/frpc.toml"
  tmp_access="$work/access-info.txt"
  tmp_state="$work/client-state.json"
  enabled_list="$work/enabled.json"
  frp_enabled_services_list "$candidate" >"$enabled_list"
  transport="$(python3 -c 'import json,sys; print((json.load(open(sys.argv[1],encoding="utf-8")).get("frp_transport") or "tcp"))' "$candidate")"
  if ! frp_client_test_hook CONFIG_GENERATION; then
    echo "ERROR: generated frpc configuration failed verification." >&2
    if frp_compensate_previous "$allocator_url" "$enroll_id" "$enroll_secret" \
      "$machine_id" "$hostname_value" "$current" "$auth_mode"; then
      server_rollback="PASS"
      frp_pending_clear
      frp_emit_failure_class CONFIG_GENERATION_FAILED
    else
      server_rollback="FAIL"
      frp_emit_failure_class RECOVERY_REQUIRED
    fi
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    echo "LOCAL_ROLLBACK=PASS"
    echo "SERVER_ROLLBACK=${server_rollback}"
    if [[ "$server_rollback" != "PASS" ]]; then
      echo "WARNING: server registry may not match local configuration. Reconcile with a new enrollment." >&2
    fi
    return 1
  fi
  render_frpc_toml "$tmp_toml" "$server" "$port" "$token" "$host_id" "$enabled_list" "$transport"
  if ! frp_client_verify_config "$tmp_toml"; then
    echo "ERROR: generated frpc configuration failed verification." >&2
    if frp_compensate_previous "$allocator_url" "$enroll_id" "$enroll_secret" \
      "$machine_id" "$hostname_value" "$current" "$auth_mode"; then
      server_rollback="PASS"
      frp_pending_clear
      frp_emit_failure_class CONFIG_GENERATION_FAILED
    else
      server_rollback="FAIL"
      frp_emit_failure_class RECOVERY_REQUIRED
    fi
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    echo "LOCAL_ROLLBACK=PASS"
    echo "SERVER_ROLLBACK=${server_rollback}"
    if [[ "$server_rollback" != "PASS" ]]; then
      echo "WARNING: server registry may not match local configuration. Reconcile with a new enrollment." >&2
    fi
    return 1
  fi
  render_access_info "$tmp_access" "$server" "$enabled_list"
  frp_copy_state "$candidate" "$tmp_state"
  frp_state_has_secrets "$tmp_state" || {
    echo "ERROR: refusing to write client-state containing secrets" >&2
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    frp_emit_failure_class LOCAL_STATE_WRITE_FAILED
    return 1
  }

  backup="$(frp_backup_client_files)"
  if ! frp_client_test_hook BEFORE_CONFIG_REPLACE; then
    echo "ERROR: apply stopped before replacing runtime files; previous configuration was kept." >&2
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    echo "LOCAL_ROLLBACK=PASS"
    echo "SERVER_ROLLBACK=N/A"
    frp_emit_failure_class FAILED_WITH_RESERVATION_PRESERVED
    return 1
  fi
  frp_pending_write local_commit "$operation_id" ok
  if ! frp_atomic_copy_file "$(frp_client_toml_path)" "$tmp_toml" 0600 \
    || ! frp_atomic_copy_file "$(frp_client_access_path)" "$tmp_access" 0644 \
    || ! frp_atomic_write_json_file "$(frp_client_state_path)" "$tmp_state" 0600; then
    echo "ERROR: failed to write local client state; previous readable state was kept." >&2
    frp_restore_client_files "$backup" || true
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    echo "LOCAL_ROLLBACK=PASS"
    echo "SERVER_ROLLBACK=N/A"
    frp_emit_failure_class LOCAL_STATE_WRITE_FAILED
    return 1
  fi

  if ! frp_client_restart; then
    restore_needed=1
  else
    mapfile -t PROXY_NAMES < <(SERVICES_FILE="$enabled_list" proxy_names_from_services "$host_id")
    if ! frp_client_wait_proxies "${PROXY_NAMES[@]}"; then
      restore_needed=1
    fi
  fi

  if [[ "$restore_needed" == "1" ]]; then
    echo "ERROR: activation failed; restoring previous local configuration." >&2
    if frp_restore_client_files "$backup" && frp_client_restart; then
      local_rollback="PASS"
    else
      local_rollback="FAIL"
    fi
    if frp_compensate_previous "$allocator_url" "$enroll_id" "$enroll_secret" \
      "$machine_id" "$hostname_value" "$current" "$auth_mode"; then
      server_rollback="PASS"
    else
      server_rollback="FAIL"
    fi
    rm -rf "$work"
    unset enroll_secret token FRP_CLIENT_OPERATION_ID
    echo "LOCAL_ROLLBACK=${local_rollback}"
    echo "SERVER_ROLLBACK=${server_rollback}"
    if [[ "$local_rollback" != "PASS" ]]; then
      frp_emit_failure_class ROLLBACK_FAILED
    elif [[ "$server_rollback" != "PASS" ]]; then
      echo "WARNING: server registry may not match local configuration. Reconcile with a new enrollment." >&2
      frp_emit_failure_class RECOVERY_REQUIRED
    else
      frp_pending_clear
      frp_emit_failure_class FRPC_RESTART_FAILED
    fi
    return 1
  fi

  frp_copy_state "$(frp_client_state_path)" "$CANDIDATE_FILE"
  frp_pending_clear
  rm -rf "$work"
  unset enroll_secret token FRP_CLIENT_OPERATION_ID
  echo "Applied pending changes."
  echo "LOCAL_ROLLBACK=N/A"
  echo "SERVER_ROLLBACK=N/A"
}

frp_compensate_previous() {
  local allocator_url="$1" enroll_id="$2" enroll_secret="$3"
  local machine_id="$4" hostname_value="$5" previous_state="$6"
  local auth_mode="${7:-enrollment}"
  local work allocated meta
  work="$(mktemp -d)"
  allocated="$work/allocated.json"
  meta="$work/meta.json"
  echo "Attempting server registry compensation with the previous service set ..."
  if frp_enroll_services "$allocator_url" "$enroll_id" "$enroll_secret" \
    "$machine_id" "$hostname_value" "$previous_state" "$allocated" "$meta" "$auth_mode"; then
    rm -rf "$work"
    return 0
  fi
  rm -rf "$work"
  return 1
}

frp_client_interactive() {
  local current
  current="$(frp_client_state_path)"
  frp_load_client_state "$current"
  CANDIDATE_FILE="$(mktemp)"
  frp_copy_state "$current" "$CANDIDATE_FILE"
  frp_acquire_client_lock || exit 1
  trap 'rm -f "$CANDIDATE_FILE"; unset FRP_ENROLLMENT_CODE FRP_CLIENT_OPERATION_ID; frp_release_client_lock' EXIT
  trap 'exit 130' INT TERM

  local choice
  while true; do
    python3 - "$CANDIDATE_FILE" <<'PY'
import json,sys
from pathlib import Path
data=json.loads(Path(sys.argv[1]).read_text())
print()
print('FRP Client Management')
print('=====================')
print()
print(f"Client: {data.get('hostname','')}")
print(f"Server: {data.get('frp_server','')}")
print()
print('Values in [brackets] are defaults. Press Enter to accept.')
print('After enrollment, ordinary changes use this client identity.')
print('An Enrollment Code is only needed to establish or recover that identity.')
print()
print('Current services:')
print()
PY
    frp_print_state_services "$CANDIDATE_FILE"
    if ! frp_state_has_diff "$(frp_client_state_path)" "$CANDIDATE_FILE"; then
      echo
      frp_state_diff "$(frp_client_state_path)" "$CANDIDATE_FILE" || true
      echo
    fi
    echo "Actions:"
    echo
    echo "1) Add service"
    echo "2) Edit service"
    echo "3) Enable / disable service"
    echo "4) Show connection info"
    echo "5) Status"
    echo "6) Apply pending changes"
    echo "7) Discard pending changes"
    echo "8) Exit"
    echo
    if [[ "${FRP_CLIENT_TEST_MENU:-}" == "1" ]]; then
      return 0
    fi
    choice="$(read_tty "Select: " "")"
    case "$choice" in
      1) menu_add_service ;;
      2) menu_edit_service ;;
      3) menu_enable_disable ;;
      4) echo; frp_client_info ;;
      5) echo; frp_client_status ;;
      6) frp_apply_candidate || true ;;
      7)
        frp_copy_state "$(frp_client_state_path)" "$CANDIDATE_FILE"
        echo "Pending changes discarded."
        ;;
      8)
        echo "Exit."
        return 0
        ;;
      *) echo "ERROR: select 1-8" >&2 ;;
    esac
  done
}

frp_client_cmd_main() {
  local cmd="${1:-}"
  case "$cmd" in
    '' )
      frp_require_root
      frp_client_interactive
      ;;
    status)
      frp_require_root
      frp_client_status
      ;;
    info)
      frp_require_root
      frp_client_info
      ;;
    list)
      frp_require_root
      frp_client_list
      ;;
    apply)
      frp_require_root
      current="$(frp_client_state_path)"
      frp_load_client_state "$current"
      CANDIDATE_FILE="${FRP_CLIENT_CANDIDATE:-}"
      if [[ -z "$CANDIDATE_FILE" || ! -f "$CANDIDATE_FILE" ]]; then
        echo "ERROR: FRP_CLIENT_CANDIDATE must point at a candidate state file" >&2
        exit 1
      fi
      frp_acquire_client_lock || exit 1
      trap 'unset FRP_ENROLLMENT_CODE FRP_CLIENT_OPERATION_ID; frp_release_client_lock' EXIT
      trap 'exit 130' INT TERM
      frp_apply_candidate
      ;;
    update)
      frp_require_root
      shift
      frp_client_update_cmd "$@"
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage: frp-client [status|info|list|update]

  (no args)   Interactive service management menu
  status      Show local client and service status
  info        Show connection information
  list        List configured services
  update      Upgrade frp-auto-deploy management tools without re-enrolling

An Enrollment Code is required only to enroll this client or to
recover its management identity. Ordinary later changes are
authorized by the local client identity and do not require a
new Enrollment Code. A software update does not require an
Enrollment Code. Read-only commands do not contact the allocator.

For everyday use, prefer: sudo frpctl
EOF
      ;;
    *)
      echo "ERROR: unknown command: $cmd" >&2
      echo "Usage: frp-client [status|info|list|update]" >&2
      exit 2
      ;;
  esac
}

if [[ "${FRP_CLIENT_TOOL_SOURCED:-}" != "1" ]]; then
  frp_client_cmd_main "$@"
fi
