# Read-only hostname list from the local registry. Never prints secret fields.
frpctl_registry_client_names() {
  local cfg root
  cfg="$(frpctl_path /etc/frp-auto-deploy/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  python3 - "$cfg" "$root" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
if not cfg_path.is_file():
    raise SystemExit(0)
try:
    cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(cfg, dict):
    raise SystemExit(0)
reg = Path(str(cfg.get('registry_file') or ''))
if not str(reg):
    raise SystemExit(0)
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
if not reg.is_file():
    raise SystemExit(0)
try:
    state = json.loads(reg.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(state, dict):
    raise SystemExit(0)
items = [
    (str(mid), client)
    for mid, client in (state.get('clients') or {}).items()
    if isinstance(client, dict)
]
mids = [mid for mid, _client in items]

def unique_short(mid, n=8):
    text = str(mid)
    length = min(n, len(text)) or 1
    while length <= len(text):
        prefix = text[:length]
        if sum(1 for item in mids if item.startswith(prefix)) == 1:
            return prefix
        length += 1
    return text

names = []
for mid, _client in items:
    cid = unique_short(mid)
    if cid and '\n' not in cid and '\r' not in cid:
        names.append(cid)
for name in sorted(set(names)):
    print(name)
PY
}

