def print_one_line_macos(ticket, ttl, note, public_host, control_public, allocator, ca_fp, installer, ssh_user, ssh_port, client_name='', management_only=False, ticket_id='', release_channel='', source_ref=''):
    """Apple Silicon macOS zero-touch command.

    Uses the same Darwin-aware dist/bootstrap-client.sh as Linux, so there is no
    second installer artifact to keep in sync. FRP_PLATFORM=macos is an explicit
    operator assertion: the installer still detects Darwin/arm64 itself and
    refuses to continue if the host disagrees.
    """
    channel = str(release_channel or '').strip().lower()
    source_ref = str(source_ref or '').strip()
    if not channel or (channel == 'candidate' and not re.fullmatch(r'[0-9a-f]{40}', source_ref)):
        channel, source_ref = resolve_release_identity(installer)
    env_parts = [
        'FRP_ALLOCATOR_URL=%s' % shell_quote(allocator),
        'FRP_ALLOCATOR_CA_SHA256=%s' % shell_quote(ca_fp),
        'FRP_BOOTSTRAP_TICKET=%s' % shell_quote(ticket),
        'FRP_ZERO_TOUCH=1',
        'FRP_PLATFORM=macos',
    ]
    if channel:
        env_parts.append('FRP_RELEASE_CHANNEL=%s' % shell_quote(channel))
    if source_ref:
        env_parts.append('FRP_SOURCE_REF=%s' % shell_quote(source_ref))
    if ssh_user:
        env_parts.append('FRP_SSH_USER=%s' % shell_quote(ssh_user))
    if ssh_port and int(ssh_port) != 22:
        env_parts.append('FRP_SSH_PORT=%s' % shell_quote(str(int(ssh_port))))
    if management_only:
        env_parts.append('FRP_MANAGEMENT_ONLY=1')
    command = 'curl -fsSL %s | sudo env %s bash' % (
        shell_quote(installer),
        ' '.join(env_parts),
    )
    descriptor = encode_join_descriptor(allocator, ca_fp, ticket, channel, source_ref)
    tracking_id = str(ticket_id or '').strip()
    if not tracking_id and ticket:
        parts = str(ticket).split('.')
        if len(parts) >= 2:
            tracking_id = parts[1]
    print()
    print('Zero-touch macOS client command')
    print()
    print('This command contains a short-lived one-time bootstrap ticket.')
    print('Treat the command as sensitive until it expires or is used.')
    print()
    print('Run in Terminal on an Apple Silicon Mac (M1 or newer, macOS 11+).')
    print('Intel Macs are not supported and the installer will refuse to run.')
    print()
    if tracking_id:
        print('Enrollment ID: %s' % tracking_id)
        print()
    if channel:
        print('Release channel: %s' % channel)
        if source_ref:
            print('Source ref: %s' % source_ref)
        print()
    print(command)
    print()
    print('If frp-auto-deploy is already installed from Homebrew, this is equivalent:')
    print()
    print('  sudo frpctl join %s' % shell_quote(descriptor))
    print()
    print('Expires: %s (%s seconds)' % (iso(int(time.time()) + ttl), ttl))
    if client_name:
        print('Client name: %s' % client_name)
    if note:
        print('Note: %s' % note)
    if public_host and control_public:
        print('FRP Server: %s:%s' % (public_host, control_public))
    print()
    print('Send that single line to the remote user. They paste it and press Enter.')
    print('No Enrollment Code prompt or FRP configuration is required.')
    if management_only:
        print('This enrolls management identity only; no service or public port is created.')
    print()
    print('The installer does not enable Remote Login, change the firewall,')
    print('or create or modify any macOS user account.')
    print()
    print('The ticket is not the FRP token. It cannot manage the client after enrollment.')
    print('It cannot be reused by another machine once bound.')
    print('Status:')
    print('  sudo frpctl status')
    if tracking_id:
        print()
        print('Track or revoke with the Enrollment ID (not the ticket secret):')
        print('  show enrollments')
        print('  revoke enrollment %s' % tracking_id)
    print()


