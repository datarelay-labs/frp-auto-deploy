def main(argv=None):
    a = parse_args(argv)
    if a.ttl is None or int(a.ttl) <= 0:
        fail('TTL must be a positive integer')
    ttl = int(a.ttl)

    if a.ssh_user and not a.ssh:
        fail('--ssh-user requires --ssh')
    if a.ssh_port is not None and not a.ssh:
        fail('--ssh-port requires --ssh')
    if a.rdp_port is not None and not a.rdp:
        fail('--rdp-port requires --rdp')
    if a.services_file and a.ssh:
        fail('use either --ssh or --services-file, not both')
    if a.services_file and a.rdp:
        fail('use either --rdp or --services-file, not both')
    if a.ssh and a.rdp:
        fail('use either --ssh or --rdp, not both')
    if (a.ssh or a.rdp or a.services_file) and not a.one_line:
        fail('--ssh, --rdp, and --services-file require --one-line')
    platform = str(a.platform or 'linux').strip().lower()
    if platform not in ('linux', 'windows', 'macos'):
        fail('--platform must be linux, windows, or macos')
    if a.rdp and platform == 'macos':
        fail('RDP is not offered on macOS; use --ssh or --services-file')

    ssh_port = 22
    port_explicit = a.ssh_port is not None
    if port_explicit:
        ssh_port = coerce_port(a.ssh_port)
        if ssh_port is None:
            fail('invalid --ssh-port; must be an integer 1-65535')
    ssh_user = normalize_ssh_user(a.ssh_user)

    rdp_port = 3389
    rdp_port_explicit = a.rdp_port is not None
    if rdp_port_explicit:
        rdp_port = coerce_port(a.rdp_port)
        if rdp_port is None:
            fail('invalid --rdp-port; must be an integer 1-65535')

    cfg = json.loads(Path(CONFIG).read_text())
    enroll_dir = remap(cfg['enrollments_dir'])
    enroll_dir.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(str(enroll_dir), 0o700)
    except OSError:
        pass

    public_host = cfg_public_host(cfg)
    control_public = cfg_frp_control_public_port(cfg)
    allocator = str(cfg.get('allocator_public_url', '') or '').strip()
    ca_path = remap(str(cfg.get('tls_ca_cert') or '/etc/frp-auto-deploy/pki/ca.crt'))
    ca_fp = fingerprint_from_cert(ca_path) if ca_path.is_file() else ''
    if platform == 'windows':
        installer = str(cfg.get('windows_client_installer_url', '') or '').strip()
        installer_label = 'Windows client installer URL'
    elif platform == 'macos':
        # macOS shares the Darwin-aware POSIX bootstrap with Linux. An explicit
        # macos_client_installer_url overrides it only if an operator set one.
        installer = str(cfg.get('macos_client_installer_url', '') or '').strip()
        if not installer:
            installer = str(cfg.get('client_installer_url', '') or '').strip()
        installer_label = 'macOS client installer URL'
    else:
        installer = str(cfg.get('client_installer_url', '') or '').strip()
        installer_label = 'client installer URL'

    reject_control_chars('--note', a.note)
    reject_control_chars('--client-name', a.client_name)
    reject_control_chars('allocator public URL', allocator)
    reject_control_chars(installer_label, installer)
    reject_control_chars('--ssh-user', ssh_user)
    client_name = str(a.client_name or '').strip()
    note = str(a.note or '')
    if client_name:
        client_name, err = validate_prompt_label(client_name)
        if err:
            fail(err)
    if len(note) > 1024:
        fail('note must be at most 1024 characters')

    assigned_group_ids = resolve_enrollment_group_ids(cfg, a.group)

    if not a.one_line:
        enrollment_id = secrets.token_hex(8)
        secret = secrets.token_hex(32)
        record, _path = write_enrollment(
            enroll_dir,
            enrollment_id,
            secret,
            ttl,
            note,
            label=client_name,
            assigned_group_ids=assigned_group_ids,
        )
        run_enrollment_retention_cleanup(cfg)
        print_manual(cfg, record, ttl, public_host, control_public, allocator, ca_fp, installer)
        return 0

    if a.ssh and not ssh_user and not is_interactive_stdin():
        fail(NONINTERACTIVE_SSH_USER_ERROR)

    if not installer:
        if platform == 'windows':
            fail(
                'Windows client installer URL is not configured; '
                'set windows_client_installer_url in server config '
                '(or re-run the server installer) before --one-line --platform windows'
            )
        if platform == 'macos':
            fail(
                'macOS client installer URL is not configured; '
                'run sudo frp-set-client-installer-url before --one-line --platform macos'
            )
        fail(
            'client installer URL is not configured; '
            'run sudo frp-set-client-installer-url before --one-line'
        )
    if not allocator:
        fail('allocator public URL is not configured; cannot generate a zero-touch command')
    if not allocator.lower().startswith('https://'):
        fail('allocator public URL must be HTTPS')
    if not ca_fp:
        fail('allocator CA SHA256 fingerprint is not available; cannot generate a secure command')

    alloc_mod = load_allocator()
    if alloc_mod is None:
        fail('allocator module is missing')

    if is_interactive_stdin() and (not client_name or not str(a.note or '').strip()):
        client_name, note = prompt_client_identification(client_name, note)
        reject_control_chars('--client-name', client_name)
        reject_control_chars('--note', note)

    rdp_local = None
    if a.ssh:
        ssh_user, ssh_port = resolve_zero_touch_ssh(ssh_user, ssh_port, port_explicit)
        reject_control_chars('--ssh-user', ssh_user)
        raw_services = [ssh_service(ssh_user, ssh_port)]
    elif a.rdp:
        raw_services = [rdp_service(rdp_port)]
        rdp_local = rdp_port
    else:
        raw_services = load_services_file(a.services_file) if a.services_file else []
        for item in raw_services:
            if isinstance(item, dict) and str(item.get('preset') or '').lower() == 'rdp':
                rdp_local = coerce_port(item.get('local_port')) or 3389
                break

    try:
        services = alloc_mod.normalize_services(raw_services)
    except alloc_mod.ServiceValidationError as exc:
        fail(str(exc))

    ssh_user, ssh_pre_port = first_ssh_preflight(services)
    print_client_configuration(client_name, note, ssh_user, ssh_pre_port)

    bootstrap_cfg = str(cfg.get('bootstrap_dir') or '').strip()
    if bootstrap_cfg:
        bootstrap_dir = remap(bootstrap_cfg)
    else:
        bootstrap_dir = enroll_dir.parent / 'bootstrap'

    try:
        ticket, _enroll_record, ticket_record = alloc_mod.issue_bootstrap_ticket(
            enroll_dir,
            bootstrap_dir,
            services,
            ttl,
            note,
            label=client_name,
            assigned_group_ids=assigned_group_ids,
            cfg=cfg,
        )
    except Exception as exc:
        fail('failed to issue bootstrap ticket: %s' % exc)

    ticket_id = str((ticket_record or {}).get('id') or '')
    release_channel, source_ref = resolve_release_identity(installer)
    if platform == 'windows':
        print_one_line_windows(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            rdp_port=rdp_local,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            release_channel=release_channel,
            source_ref=source_ref,
        )
    elif platform == 'macos':
        print_one_line_macos(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            ssh_user,
            ssh_pre_port,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            release_channel=release_channel,
            source_ref=source_ref,
        )
    else:
        print_one_line(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            ssh_user,
            ssh_pre_port,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            release_channel=release_channel,
            source_ref=source_ref,
        )
    try:
        here = Path(__file__).resolve()
        for path in (
            here.parent.parent / 'lib' / 'frp_audit.py',
            Path('/usr/local/lib/frp-auto-deploy/frp_audit.py'),
        ):
            if path.is_file():
                spec = importlib.util.spec_from_file_location('frp_audit', str(path))
                audit = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(audit)
                audit.try_emit(
                    'enrollment.created',
                    details={
                        'label': client_name,
                        'assigned_group_ids': assigned_group_ids or None,
                    },
                )
                break
    except Exception:
        pass
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
