      fi
      ;;
    menu) frpctl_interactive ;;
    history) frpctl_print_history ;;
    clear) frpctl_clear_screen ;;
    exit)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
      fi
      return 0
      ;;
    *)
      set -e
      return 1
      ;;
  esac
  _FRP_CTL_RC=$?
  set -e
  return 0
}

frpctl_set_client_from_canon() {
  local spec="$1" client prop value
  client="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("client",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    label) frpctl_invoke frp-client-set "$client" --label "$value" ;;
    note) frpctl_invoke frp-client-set "$client" --note "$value" ;;
    tag) frpctl_invoke frp-client-set "$client" --tag "$value" ;;
    *) echo "ERROR: unknown client setting" >&2; return 1 ;;
  esac
}

frpctl_unset_client_from_canon() {
  local spec="$1" client prop value
  client="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("client",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    label) frpctl_invoke frp-client-set "$client" --clear-label ;;
    note) frpctl_invoke frp-client-set "$client" --clear-note ;;
    tag) frpctl_invoke frp-client-set "$client" --remove-tag "$value" ;;
    *) echo "ERROR: unknown client setting" >&2; return 1 ;;
  esac
}

frpctl_set_group_from_canon() {
  local spec="$1" group prop value
  group="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("group",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    name) frpctl_invoke frp-group-set set "$group" --name "$value" ;;
    description) frpctl_invoke frp-group-set set "$group" --description "$value" ;;
    *) echo "ERROR: unknown group setting" >&2; return 1 ;;
  esac
}

frpctl_set_group_match_tag_from_canon() {
  local spec="$1" group key value
  group="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("group",""))' "$spec")"
  key="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("key",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  frpctl_invoke frp-group-set set "$group" --match-tag "${key}=${value}"
}

frpctl_remove_group_match_tag_from_canon() {
  local spec="$1" group key
  group="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("group",""))' "$spec")"
  key="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("key",""))' "$spec")"
  frpctl_invoke frp-group-set set "$group" --remove-match-tag "$key"
}

frpctl_create_group_from_canon() {
  local spec="$1"
  python3 - "$spec" <<'PY'
import json
import os
import subprocess
import sys

spec = json.loads(sys.argv[1])
name = spec.get('name') or ''
passthrough = spec.get('passthrough') or []
bin_dir = os.environ.get('FRP_CTL_BIN_DIR') or '/usr/local/bin'
tool = os.path.join(bin_dir, 'frp-group-set')
args = [tool, 'create', name] + list(passthrough)
raise SystemExit(subprocess.call(args))
PY
}

# Locate the installer that ships alongside this frpctl (Homebrew libexec tree
# or a development checkout). Never a downloaded or /home/... path.
frpctl_local_install_client() {
  local cand
  for cand in \
    "${_FRPCTL_DIR}/../install-client.sh" \
    "${_FRPCTL_DIR}/../libexec/install-client.sh"; do
    if [[ -f "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

# `sudo frpctl join '<descriptor>'` — compact macOS enrollment.
#
# The descriptor is the same frpj1 credential the Windows launcher consumes. It
# is decoded and validated locally, then handed to the installer through the
# environment rather than argv so the one-time ticket never appears in `ps`.
frpctl_join() {
  local descriptor="${1:-}" decoded installer line key value
  if [[ -z "$descriptor" || "$descriptor" == "-h" || "$descriptor" == "--help" ]]; then
    echo "Usage: sudo frpctl join '<descriptor>'"
    echo
    echo "Enrolls this Mac using the compact join credential printed by"
    echo "'create zero-touch' on the FRP server (macOS platform)."
    return 2
  fi
  if [[ $# -gt 1 ]]; then
    echo "ERROR: join takes exactly one descriptor argument." >&2
    echo "Quote it: sudo frpctl join '<descriptor>'" >&2
    return 2
  fi
  if ! declare -F frp_macos_decode_join_descriptor >/dev/null 2>&1; then
    echo "ERROR: macOS support module is not installed on this host." >&2
    return 1
  fi
  if ! frp_is_darwin; then
    echo "ERROR: 'frpctl join' is available on macOS only." >&2
    echo "On Linux, use the curl one-line command from the server." >&2
    return 1
  fi
  if [[ ${EUID} -ne 0 && -z "${FRP_CTL_TEST_ROOT:-}" ]]; then
    echo "ERROR: run with sudo: sudo frpctl join '<descriptor>'" >&2
    return 1
  fi
  if frpctl_is_client; then
    echo "ERROR: this Mac already has an FRP client installed." >&2
    echo "A software update does not need a join descriptor: sudo frpctl update" >&2
    return 1
  fi
  decoded="$(frp_macos_decode_join_descriptor "$descriptor")" || return 1
  if ! installer="$(frpctl_local_install_client)"; then
    echo "ERROR: install-client.sh was not found next to this frpctl." >&2
    echo "Use the curl one-line command from the server instead." >&2
    return 1
  fi
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    [[ -n "$value" ]] || continue
    export "${key}=${value}"
  done <<<"$decoded"
  export FRP_ZERO_TOUCH=1
  export FRP_PLATFORM=macos
  bash "$installer"
}

frpctl_dispatch() {
  local cmd="${1:-}"
  _FRP_CTL_RC=0
  if [[ -n "$cmd" ]] && frpctl_dispatch_canonical "$@"; then
    return "${_FRP_CTL_RC:-0}"
  fi
  shift || true
  case "$cmd" in
    -h|--help)
      frpctl_usage
      ;;
    help|'?')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        frpctl_repl_help "$@"
      else
        if [[ $# -gt 0 ]]; then
          frpctl_repl_help "$@"
        else
          frpctl_usage
        fi
      fi
      ;;
    menu)
      frpctl_interactive
      ;;
    join)
      frpctl_join "$@"
      ;;
    status)
      frpctl_status "$@"
      ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frp_doctor_main "$@"
      ;;
    client-status)
      frpctl_require_client || return 1
      frpctl_run frp-client status "$@"
      ;;
    server-status)
      frpctl_require_server || return 1
      frpctl_run frp-server-status "$@"
      ;;
    version)
      echo
      frpctl_print_version
      echo
      ;;
    update)
      frpctl_update "$@"
      ;;
    client-update)
      frpctl_require_client || return 1
      frpctl_client_update "$@"
      ;;
    server-update|frp-update)
      frpctl_require_server || return 1
      frpctl_run frp-update "$@"
      ;;
    project-update)
      frpctl_require_server || return 1
      frpctl_run frp-project-update "$@"
      ;;
    backup)
      frpctl_require_server || return 1
      frpctl_run frp-backup "$@"
      ;;
    restore)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        frpctl_usage_error "restore <backup>"
        return $?
      fi
      frpctl_run frp-restore "$@"
      ;;
    enroll-bulk)
      frpctl_require_server || return 1
      frpctl_invoke frp-enroll-bulk "$@"
      ;;
    enrollments)
      frpctl_require_server || return 1
      frpctl_invoke frp-enrollments "$@"
      ;;
    enrollment-revoke)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        frpctl_usage_error "enrollment-revoke <id>"
        return $?
      fi
      frpctl_invoke frp-enrollment-revoke "$@"
      ;;
    upstream)
      frpctl_require_server || return 1
      frpctl_run frp-upstream "$@"
      ;;
    audit)
      frpctl_require_server || return 1
      frpctl_audit_tail
      ;;
    clear)
      frpctl_clear_screen
      ;;
    exit|quit|q)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
        return 0
      fi
      return 0
      ;;
    manage)
      frpctl_require_client || return 1
      frpctl_invoke frp-client "$@"
      ;;
    services)
      frpctl_require_client || return 1
      frpctl_invoke frp-client list "$@"
      ;;
    info)
      frpctl_require_client || return 1
      frpctl_invoke frp-client info "$@"
      ;;
    clients)
      frpctl_require_server || return 1
      frpctl_invoke frp-clients "$@"
      ;;
    enroll|create-client)
      frpctl_require_server || return 1
      frpctl_invoke frp-create-client "$@"
      ;;
    client|client-info)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "client" ]]; then
          frpctl_usage_error "client <name>"
        else
          frpctl_usage_error "frpctl client-info <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-client-info "$@"
      ;;
    client-set|edit-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "client-set <client> [--label NAME] [--note TEXT]"
        else
          frpctl_usage_error "frpctl client-set <client> [--label NAME] [--note TEXT]"
        fi
        return $?
      fi
      frpctl_invoke frp-client-set "$@"
      ;;
    revoke|revoke-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "revoke" ]]; then
          frpctl_usage_error "revoke <name>"
        else
          frpctl_usage_error "frpctl revoke-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-revoke-client "$@"
      ;;
    release-service)
      frpctl_require_server || return 1
      if [[ $# -lt 2 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-service <client> <service-id>"
        else
          frpctl_usage_error "frpctl release-service <client> <service-id>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-service "$@"
      ;;
    release-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-client <client>"
        else
          frpctl_usage_error "frpctl release-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-client "$@"
      ;;
    shell|exec|bash|sh|system)
      frpctl_reject_shell
      ;;
    '!'*|\!*)
      frpctl_reject_shell
      ;;
    '')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        return 0
      fi
      frpctl_repl
      ;;
    *)
      frpctl_unknown_command "$cmd"
      ;;
  esac
}

frpctl_tokenize() {
  local line="$1" py json
  _FRP_CTL_TOKENS=()
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n "$line" ]] || return 0
  py="$(frpctl_grammar_py)" || return 1
  json="$(python3 "$py" tokenize "$line")" || return 2
  # Read loop rather than mapfile: frpctl also runs under bash 3.2 on macOS.
  # Empty tokens are preserved; the user may have typed a quoted empty argument.
  local token_line
  while IFS= read -r token_line; do
    _FRP_CTL_TOKENS+=("$token_line")
  done < <(python3 -c 'import json,sys; [print(t) for t in json.loads(sys.argv[1])]' "$json")
}

frpctl_history_maybe_record() {
  local line="$1"
  [[ -n "$line" ]] || return 0
  if python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import frp_ctl_grammar as g; raise SystemExit(0 if g.looks_secret(sys.argv[2]) else 1)' \
    "$(dirname "$(frpctl_grammar_py)")" "$line"; then
    return 0
  fi
  _FRP_CTL_SESSION_HIST+=("$line")
  history -s "$line" 2>/dev/null || true
}

frpctl_print_history() {
  local i
  if [[ ${#_FRP_CTL_SESSION_HIST[@]} -eq 0 ]]; then
    echo "(no session history)"
    return 0
  fi
  for i in "${!_FRP_CTL_SESSION_HIST[@]}"; do
    printf '%5s  %s\n' "$((i + 1))" "${_FRP_CTL_SESSION_HIST[$i]}"
  done
}

frpctl_repl_sigint() {
  _FRP_CTL_SIGINT=1
}

frpctl_repl_banner() {
  echo "FRP Auto Deploy CLI"
  echo "==================="
  echo
  echo "Role            : $(frpctl_role_label)"
  echo "Project version : $(frpctl_project_version)"
  echo "Release channel : $(frpctl_release_channel)"
  echo "Source ref      : $(frpctl_source_ref)"
  echo "FRP version     : $(frpctl_frp_version)"
  echo "Bundle SHA256   : $(frpctl_bundle_sha256)"
  echo
  echo "Type '?' for a short command list, or 'help' for full syntax."
  echo "Press Tab to complete a unique match or list next-token candidates."
  echo "On a server, Tab completes CLIENT IDs and service IDs."
  echo "Type 'menu' for the guided menu."
  echo "Type 'exit' to leave."
  echo
}

frpctl_repl_read_line() {
  _FRP_CTL_LINE=""
  frpctl_input_init
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    printf 'frpctl> '
    if ! IFS= read -r _FRP_CTL_LINE <&9; then
      return 1
    fi
    printf '%s\n' "$_FRP_CTL_LINE"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "ERROR: interactive frpctl requires a TTY." >&2
    echo "Use: frpctl <command>" >&2
    return 1
  fi
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    if ! IFS= read -e -r -p "frpctl> " _FRP_CTL_LINE; then
      return 1
    fi
  else
    # No readline: Tab is a literal character, not filesystem completion.
    printf 'frpctl> '
    if ! IFS= read -r _FRP_CTL_LINE; then
      return 1
    fi
  fi
  return 0
}

frpctl_repl() {
  local rc
  frpctl_require_install || return 1
  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && ! -t 0 ]]; then
    echo "ERROR: interactive frpctl requires a TTY." >&2
    echo "Use: frpctl <command>" >&2
    return 1
  fi

  # Session history for ↑/↓ only. Never write a history file.
  unset HISTFILE
  set -o history 2>/dev/null || true
  set +o histexpand 2>/dev/null || true
  _FRP_CTL_SESSION_HIST=()
  FRP_CTL_REPL=1
  _FRP_CTL_SHOULD_EXIT=0
  _FRP_CTL_SIGINT=0
  _FRP_CTL_BOUND_TAB=""
  frpctl_tab_reset
  trap 'frpctl_repl_sigint' INT

  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && -t 0 && "${FRP_CTL_DISABLE_TAB:-}" != "1" ]]; then
    if _FRP_CTL_REPL_PY="$(frpctl_repl_py 2>/dev/null)" && python3 -c 'import readline' 2>/dev/null; then
      _FRP_CTL_BOUND_TAB=1
      frpctl_repl_banner
      FRP_CTL_GRAMMAR_PAYLOAD="$(frpctl_grammar_payload)" \
        FRPCTL_BIN="${BASH_SOURCE[0]}" \
        PYTHONUNBUFFERED=1 \
        python3 -u "$_FRP_CTL_REPL_PY" --frpctl "${BASH_SOURCE[0]}"
      trap - INT
      FRP_CTL_REPL=0
      return 0
    fi
    frpctl_repl_enable_completion
  fi

  frpctl_repl_banner

  while true; do
    _FRP_CTL_SIGINT=0
    _FRP_CTL_LINE=""
    if ! frpctl_repl_read_line; then
      if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
        echo
        continue
      fi
      echo
      break
    fi
    if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
      echo
      continue
    fi
    if ! frpctl_tokenize "$_FRP_CTL_LINE"; then
      echo "ERROR: could not parse command line." >&2
      continue
    fi
    if [[ ${#_FRP_CTL_TOKENS[@]} -eq 0 ]]; then
      continue
    fi
    frpctl_history_maybe_record "$_FRP_CTL_LINE"
    case "${_FRP_CTL_TOKENS[0]}" in
      '!'*|shell|exec|bash|sh|system)
        frpctl_reject_shell || true
        continue
        ;;
    esac
    rc=0
    frpctl_dispatch "${_FRP_CTL_TOKENS[@]}" || rc=$?
    if [[ "${_FRP_CTL_SHOULD_EXIT}" == "1" ]]; then
      break
    fi
    if [[ "$rc" -ne 0 && "$rc" -ne 130 ]]; then
      echo
      echo "Command failed with exit code ${rc}."
      echo
    fi
  done

  trap - INT
  frpctl_repl_disable_completion
  frpctl_input_cleanup
  FRP_CTL_REPL=0
  return 0
}

frpctl_main() {
  local cmd="${1:-}"
  case "$cmd" in
    '')
      frpctl_repl
      ;;
    *)
      frpctl_dispatch "$@"
      ;;
  esac
}

if [[ "${FRP_CTL_SOURCED:-}" != "1" ]]; then
  frpctl_main "$@"
fi
