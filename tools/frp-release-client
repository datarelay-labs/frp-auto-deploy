#!/usr/bin/env python3
import argparse
import json
import os
import socket
import tempfile
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
UNSUPPORTED = (
    'ERROR: unsupported registry schema; redeploy/reset registry for the generic-service version'
)

parser = argparse.ArgumentParser(description='Release a client record and its reserved ports')
parser.add_argument('query', help='hostname or machine-id prefix')
parser.add_argument('--force', action='store_true', help='release even if a published port is currently active')
args = parser.parse_args()


def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        raise SystemExit(UNSUPPORTED)
    for client in (state.get('clients') or {}).values():
        if not isinstance(client, dict):
            raise SystemExit(UNSUPPORTED)
        if 'ssh_port' in client or 'https_port' in client:
            raise SystemExit(UNSUPPORTED)


def active(port):
    if not port:
        return False
    s = socket.socket()
    s.settimeout(0.3)
    try:
        return s.connect_ex(('127.0.0.1', int(port))) == 0
    finally:
        s.close()


cfg = json.loads(Path(ROOT + '/etc/frp-auto-deploy/config.json').read_text())
path = Path(cfg['registry_file'])
if ROOT and not str(path).startswith(ROOT):
    path = Path(ROOT + str(path))
state = json.loads(path.read_text())
require_v2(state)

matches = []
for mid, client in (state.get('clients') or {}).items():
    if mid.startswith(args.query) or client.get('hostname') == args.query:
        matches.append((mid, client))
if len(matches) != 1:
    raise SystemExit('Expected exactly one matching client')
mid, client = matches[0]

services = client.get('services') or {}
if not isinstance(services, dict):
    services = {}
ports = []
for sid, svc in sorted(services.items()):
    if not isinstance(svc, dict):
        continue
    port = svc.get('remote_port')
    if port:
        ports.append((sid, int(port), svc.get('enabled', True) is not False))

if any(active(port) for _sid, port, _enabled in ports) and not args.force:
    raise SystemExit('Client appears online. Uninstall/stop frpc first, or use --force.')

print(f'Releasing {client.get("hostname")} ({mid})')
if ports:
    print('Services:')
    for sid, port, enabled in ports:
        suffix = '' if enabled else ' (reserved)'
        print(f'  {sid}: {port}{suffix}')
else:
    print('Services: (none)')
answer = input('Type RELEASE to continue: ')
if answer != 'RELEASE':
    raise SystemExit('Cancelled')

state['clients'].pop(mid)
fd, tmp = tempfile.mkstemp(prefix='registry.', suffix='.tmp', dir=str(path.parent))
with os.fdopen(fd, 'w') as f:
    json.dump(state, f, indent=2, sort_keys=True)
    f.write('\n')
    f.flush()
    os.fsync(f.fileno())
os.chmod(tmp, 0o600)
os.replace(tmp, path)
print('Released.')
