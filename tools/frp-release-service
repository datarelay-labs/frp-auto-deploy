#!/usr/bin/env python3
import argparse
import fcntl
import importlib.util
import json
import os
import tempfile
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()

def require_valid_registry(state, cfg=None):
    try:
        return CREG.validate_registry_or_raise(state, cfg)
    except ValueError as exc:
        raise SystemExit('ERROR: %s' % exc)



def lock_registry(path):
    lock_path = Path(path).resolve().parent / 'registry.lock'
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def unlock_registry(fd):
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def atomic_write_json(path, data, mode=0o600):
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)



parser = argparse.ArgumentParser(
    description='Release one service reservation; keep the client management record'
)
parser.add_argument('query', help='immutable CLIENT ID (exact registry key)')
parser.add_argument('service_id', help='service id to release')
args = parser.parse_args()


def load_release_guard():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_release_guard.py',
        Path('/usr/local/lib/frp-auto-deploy/frp_release_guard.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/frp-auto-deploy/frp_release_guard.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_release_guard', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_release_guard.py')


RG = load_release_guard()


def ensure_releasable(service, force=False):
    port = service.get('remote_port') if isinstance(service, dict) else None
    if port:
        try:
            RG.ensure_port_releasable(port, cfg=cfg, force=force)
        except ValueError as exc:
            raise SystemExit('ERROR: %s' % exc) from exc


cfg = json.loads(Path(ROOT + '/etc/frp-auto-deploy/config.json').read_text())
path = Path(cfg['registry_file'])
if ROOT and not str(path).startswith(ROOT):
    path = Path(ROOT + str(path))
state = json.loads(path.read_text())
require_valid_registry(state, cfg)

mid, client = CREG.resolve_client_id_only_or_exit(state, args.query)

sid = str(args.service_id).strip().lower()
services = client.get('services') or {}
if not isinstance(services, dict) or sid not in services:
    raise SystemExit(f'ERROR: service {sid} was not found on this client')
svc = services[sid]
if not isinstance(svc, dict):
    raise SystemExit(f'ERROR: service {sid} was not found on this client')
port = svc.get('remote_port')
if port:
    ensure_releasable(svc)

print(f'Releasing {CREG.sanitize_display(CREG.display_name(client, mid), 64)} '
      f'({CREG.sanitize_display(mid, 128)}) service {CREG.sanitize_display(sid, 32)}')
print('The client management record is kept.')
if port:
    print(f'Port: {port}')
answer = input('Type RELEASE to continue: ')
if answer != 'RELEASE':
    raise SystemExit('Cancelled')

lock_fd = lock_registry(path)
try:
    state = json.loads(path.read_text())
    require_valid_registry(state, cfg)
    mid, client = CREG.resolve_client_id_only_or_exit(state, args.query)
    services = client.get('services') or {}
    if not isinstance(services, dict) or sid not in services:
        raise SystemExit(f'ERROR: service {sid} was not found on this client')
    svc = services[sid]
    if not isinstance(svc, dict):
        raise SystemExit(f'ERROR: service {sid} was not found on this client')
    port = svc.get('remote_port')
    # Re-check under the registry lock to close the TOCTOU window.
    if port:
        # Re-check passively under the registry lock to close the TOCTOU window.
        ensure_releasable(svc)
    services = dict(services)
    services.pop(sid)
    client['services'] = services
    state['clients'][mid] = client
    require_valid_registry(state, cfg)
    atomic_write_json(path, state)
finally:
    unlock_registry(lock_fd)
print('Released. Client management record retained.')
try:
    here = Path(__file__).resolve()
    for path in (
        here.parent.parent / 'lib' / 'frp_audit.py',
        Path('/usr/local/lib/frp-auto-deploy/frp_audit.py'),
    ):
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_audit', str(path))
            audit = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(audit)
            audit.try_emit(
                'service.released',
                client_id=mid,
                details={'service_id': sid},
            )
            break
except Exception:
    pass
