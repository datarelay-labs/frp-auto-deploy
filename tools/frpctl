        frpctl_server_lifecycle_dispatch test || true
        echo
      fi
      if frpctl_is_client; then
        echo "=== Client test ==="
        frpctl_lifecycle_dispatch test || true
      fi
      ;;
    dual_logs)
      frpctl_load_passthrough_args "$result"
      if frpctl_is_server; then
        echo "=== Server logs ==="
        frpctl_server_lifecycle_dispatch logs ${_FRP_CTL_ARGS[@]+"${_FRP_CTL_ARGS[@]}"} || true
        echo
      fi
      if frpctl_is_client; then
