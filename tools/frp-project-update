#!/usr/bin/env bash
set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_SCRIPT_DIR}/../lib/frp-common.sh" ]]; then
  # shellcheck source=../lib/frp-common.sh
  . "${_SCRIPT_DIR}/../lib/frp-common.sh"
elif [[ -f /usr/local/lib/frp-auto-deploy/frp-common.sh ]]; then
  # shellcheck disable=SC1091
  . /usr/local/lib/frp-auto-deploy/frp-common.sh
else
  echo "ERROR: missing lib/frp-common.sh" >&2
  exit 1
fi

usage() {
  cat <<'EOF'
Usage: frp-project-update [--check] [--source DIR]

Safely refresh frp-auto-deploy server management software without changing the
FRP binary or asking installation questions.

  --check, --dry-run  verify the candidate and report update availability only
  --source DIR        use a local source tree (tests/development)
  -h, --help          show this help
EOF
}

CHECK_ONLY=0
SOURCE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--dry-run) CHECK_ONLY=1; shift ;;
    --source)
      [[ $# -ge 2 ]] || { echo "ERROR: --source requires a directory" >&2; exit 2; }
      SOURCE="$2"
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ ${EUID} -ne 0 && -z "${FRP_SERVER_TEST_ROOT:-}" ]]; then
  echo "ERROR: run with sudo" >&2
  exit 1
fi

if [[ -n "$SOURCE" ]]; then
  source_args=(--upgrade --source "$SOURCE")
  if [[ "$CHECK_ONLY" == "1" ]]; then
    source_args+=(--check)
  fi
  exec bash "${SOURCE}/install-server.sh" "${source_args[@]}"
fi

tmp="$(frp_secure_mktemp_dir)"
trap 'rm -rf "$tmp"' EXIT
sums="${tmp}/SHA256SUMS"
bundle="${tmp}/bootstrap-server.sh"
sums_url="${FRP_SERVER_PROJECT_SHA256SUMS_URL:-$(frp_default_release_sha256sums_url)}"
bundle_url="${FRP_SERVER_PROJECT_UPDATE_URL:-$(frp_default_server_project_update_url)}"

for url in "$sums_url" "$bundle_url"; do
  case "$url" in
    https://?*) ;;
    *)
      echo "ERROR: server project update URLs must use HTTPS" >&2
      exit 1
      ;;
  esac
done

echo "Downloading release checksum metadata..."
curl -fL --retry 3 --connect-timeout 10 --max-time 120 -o "$sums" "$sums_url" || {
  echo "ERROR: failed to download SHA256SUMS" >&2
  exit 1
}
expected="$(frp_sha256sum_entry "$sums" dist/bootstrap-server.sh 2>/dev/null || true)"
if [[ -z "$expected" ]]; then
  echo "ERROR: SHA256SUMS is missing valid metadata for dist/bootstrap-server.sh" >&2
  exit 1
fi

echo "Downloading server project update bundle..."
curl -fL --retry 3 --connect-timeout 10 --max-time 120 -o "$bundle" "$bundle_url" || {
  echo "ERROR: failed to download the server project update bundle" >&2
  exit 1
}
frp_verify_sha256 "$expected" "$bundle" >/dev/null || {
  echo "ERROR: downloaded server project update failed SHA256 verification" >&2
  exit 1
}
chmod 0755 "$bundle"

args=(--upgrade)
if [[ "$CHECK_ONLY" == "1" ]]; then
  args+=(--check)
fi
FRP_EXPECTED_SOURCE_REF="$(frp_release_git_ref)" \
FRP_EXPECTED_RELEASE_CHANNEL="$(frp_release_channel)" \
FRP_BUNDLE_SHA256="$expected" \
  exec bash "$bundle" "${args[@]}"
