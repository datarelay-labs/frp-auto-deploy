      fi
      ;;
    dual_support_bundle)
      frpctl_load_passthrough_args "$result"
      if frpctl_is_server; then
        echo "=== Server support bundle ==="
        frpctl_server_lifecycle_dispatch support-bundle ${_FRP_CTL_ARGS[@]+"${_FRP_CTL_ARGS[@]}"} || true
        echo
      fi
      if frpctl_is_client; then
        echo "=== Client support bundle ==="
        frpctl_lifecycle_dispatch support-bundle ${_FRP_CTL_ARGS[@]+"${_FRP_CTL_ARGS[@]}"} || true
      fi
      ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frpctl_load_passthrough_args "$result"
