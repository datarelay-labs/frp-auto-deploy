  local libdir args_json
  libdir="$(frpctl_python_lib)"
  args_json="${1:-[]}"
  PYTHONPATH="${libdir}${PYTHONPATH:+:$PYTHONPATH}" \
    FRP_DEPLOY_TEST_ROOT="${FRP_DEPLOY_TEST_ROOT:-${FRP_CTL_TEST_ROOT:-}}" \
    FRP_CTL_TEST_ROOT="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}" \
    python3 - "$libdir" "$args_json" <<'PY'
import importlib.util
import json
import sys
from pathlib import Path

libdir = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location('frp_audit', str(libdir / 'frp_audit.py'))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

args = json.loads(sys.argv[2] or '[]')
opts = {}
i = 0
while i < len(args):
    tok = args[i]
    if tok in ('--since', '--event', '--client', '--group', '--format', '--lines', '-n'):
        if i + 1 >= len(args):
            raise SystemExit('ERROR: %s requires a value' % tok)
        key = tok.lstrip('-').replace('-', '_')
        if key == 'n':
            key = 'lines'
        opts[key] = args[i + 1]
        i += 2
        continue
    raise SystemExit('ERROR: unknown audit option: %s' % tok)

since = opts.get('since')
event = opts.get('event')
client_id = opts.get('client')
group = opts.get('group')
fmt = (opts.get('format') or 'table').strip().lower()
limit = int(opts.get('lines') or 500)
try:
    rows = mod.query(
        since=since,
        event=event,
        client_id=client_id,
        group=group,
        limit=limit,
    )
except ValueError as exc:
    raise SystemExit('ERROR: %s' % exc) from exc
if fmt == 'json':
    sys.stdout.write(mod.format_audit_json(rows))
elif fmt == 'csv':
    sys.stdout.write(mod.format_audit_csv(rows))
elif fmt in ('table', ''):
    text = mod.format_audit_table(rows)
    sys.stdout.write(text if text.strip() else '(no audit log)\n')
else:
    raise SystemExit('ERROR: unknown format: %s' % fmt)
PY
}

