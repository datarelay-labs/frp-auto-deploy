frpctl_zt_prompt_ssh() {
  local user="" port=""
  echo
  echo "SSH"
  echo "==="
  echo
  while true; do
    user="$(frpctl_read "SSH user: " "")" || return 1
    user="${user#"${user%%[![:space:]]*}"}"
    user="${user%"${user##*[![:space:]]}"}"
    if [[ -n "$user" ]]; then
      break
    fi
    echo "ERROR: SSH user is required." >&2
