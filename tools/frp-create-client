#!/usr/bin/env python3
import argparse
import importlib.util
import json
import os
import re
import secrets
import shlex
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
CONFIG = ROOT + '/etc/frp-auto-deploy/config.json'


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).replace(microsecond=0).isoformat().replace('+00:00', 'Z')


def remap(path):
    path = Path(path)
    if ROOT and not str(path).startswith(ROOT):
        return Path(ROOT + str(path))
    return path


def coerce_port(value):
    if value is None or isinstance(value, bool):
        return None
    try:
        port = int(value)
    except (TypeError, ValueError):
        return None
    if 1 <= port <= 65535:
        return port
    return None


def cfg_public_host(cfg):
    for key in ('public_host', 'public_ip'):
        value = cfg.get(key)
        if value is not None and str(value).strip():
            return str(value).strip()
    return ''


def cfg_frp_control_public_port(cfg):
    port = coerce_port(cfg.get('frp_control_public_port'))
    if port is not None:
        return port
    return coerce_port(cfg.get('control_port'))


def load_module(name, rel_lib, installed):
    import importlib.util
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / rel_lib,
        Path(installed),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/frp-auto-deploy' / Path(rel_lib).name)
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    return None


def load_frp_pki():
    return load_module(
        'frp_pki',
        'lib/frp_pki.py',
        '/usr/local/lib/frp-auto-deploy/frp_pki.py',
    )


def load_allocator():
    return load_module(
        'frp_port_allocator',
        'server/frp-port-allocator.py',
        '/usr/local/lib/frp-auto-deploy/frp-port-allocator.py',
    )


def fingerprint_from_cert(path):
    pki = load_frp_pki()
    if pki is None:
        return ''
    try:
        return pki.fingerprint_from_cert_file(path)
    except Exception:
        return ''


def shell_quote(value):
    quoted = shlex.quote(str(value))
    if quoted and quoted[0] not in ("'", '"'):
        quoted = "'" + quoted + "'"
    return quoted


def reject_control_chars(label, value):
    if value is None:
        return
    text = str(value)
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        fail('%s must not contain control characters or newlines' % label)


def fail(message, code=2):
    sys.stderr.write('ERROR: %s\n' % message)
    raise SystemExit(code)


def atomic_write_json(path, data, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write('\n')
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass
    try:
        path.chmod(mode)
    except OSError:
        pass


def write_enrollment(enroll_dir, enrollment_id, secret, ttl, note, label=''):
    now = int(time.time())
    record = {
        'id': enrollment_id,
        'secret': secret,
        'created_at': iso(now),
        'expires_at': now + ttl,
        'expires_at_iso': iso(now + ttl),
        'bound_machine_id': None,
        'used_at': None,
        'note': note,
        'label': label,
    }
    path = enroll_dir / (enrollment_id + '.json')
    atomic_write_json(path, record, 0o600)
    return record, path


SSH_USER_RE = re.compile(r'[A-Za-z0-9._@-]{1,32}')
NONINTERACTIVE_SSH_USER_ERROR = (
    '--ssh-user is required for non-interactive zero-touch SSH creation.'
)
_TEST_INPUT_LINES = None


def parse_args(argv=None):
    p = argparse.ArgumentParser(
        description='Create a short-lived FRP client enrollment code',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            'examples:\n'
            '  sudo frp-create-client\n'
            '  sudo frp-create-client --one-line --ssh --note client-01\n'
            '  sudo frp-create-client --one-line --ssh --ssh-user aella --note customer-01\n'
            '  sudo frp-create-client --one-line --ssh --client-name seoul-groupware --note "Seoul office"\n'
            '  sudo frp-create-client --one-line --client-name inventory-only\n'
        ),
    )
    p.add_argument('--ttl', type=int, default=600, help='TTL in seconds (default 600)')
    p.add_argument('--note', default='')
    p.add_argument(
        '--client-name',
        '--label',
        dest='client_name',
        default='',
        metavar='NAME',
        help='administrator label seeded at enrollment (does not replace hostname)',
    )
    p.add_argument(
        '--one-line',
        action='store_true',
        help='Print a one-line zero-touch client install command',
    )
    p.add_argument(
        '--ssh',
        action='store_true',
        help='SSH convenience service template (127.0.0.1:22)',
    )
    p.add_argument(
        '--ssh-user',
        default='',
        metavar='USER',
        help=(
            'SSH login account that already exists on the client '
            '(required when stdin is not a TTY; no distro default)'
        ),
    )
    p.add_argument(
        '--ssh-port',
        default=None,
        metavar='PORT',
        help='Local SSH listen port (default 22)',
    )
    p.add_argument(
        '--services-file',
        default='',
        metavar='PATH',
        help='JSON list of services (same schema as FRP_SERVICES_JSON)',
    )
    return p.parse_args(argv)


def ssh_service(ssh_user, ssh_port):
    return {
        'id': 'ssh',
        'name': 'SSH',
        'protocol': 'tcp',
        'local_ip': '127.0.0.1',
        'local_port': int(ssh_port),
        'preset': 'ssh',
        'ssh_user': ssh_user,
        'enabled': True,
    }


def load_services_file(path):
    raw_path = Path(path)
    if not raw_path.is_file():
        fail('services file is missing: %s' % path)
    try:
        data = json.loads(raw_path.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError):
        fail('services file is not valid JSON')
    if not isinstance(data, list):
        fail('services file must contain a JSON list')
    return data


def first_ssh_preflight(services):
    for item in services:
        if not isinstance(item, dict):
            continue
        if str(item.get('preset') or '').strip().lower() != 'ssh':
            continue
        user = str(item.get('ssh_user') or '').strip()
        port = coerce_port(item.get('local_port')) or 22
        return user, port
    return '', 22


def is_interactive_stdin():
    if 'FRP_CREATE_CLIENT_TEST_INPUT' in os.environ:
        return True
    try:
        return sys.stdin.isatty()
    except Exception:
        return False


def test_input_lines():
    global _TEST_INPUT_LINES
    if _TEST_INPUT_LINES is None:
        raw = os.environ.get('FRP_CREATE_CLIENT_TEST_INPUT')
        if raw is None:
            _TEST_INPUT_LINES = False
        else:
            _TEST_INPUT_LINES = iter(raw.splitlines())
    return _TEST_INPUT_LINES


def read_prompt(prompt):
    lines = test_input_lines()
    if lines is not False:
        sys.stdout.write(prompt)
        sys.stdout.flush()
        try:
            value = next(lines)
        except StopIteration:
            fail('required interactive input was not completed')
        sys.stdout.write(value + '\n')
        sys.stdout.flush()
        return value
    try:
        return input(prompt)
    except EOFError:
        fail('required interactive input was not completed')


def normalize_ssh_user(raw):
    if raw is None:
        return ''
    return str(raw).strip()


def validate_prompt_ssh_user(raw):
    user = normalize_ssh_user(raw)
    if not user:
        return '', 'SSH username cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in user):
        return '', 'SSH username must not contain control characters or newlines'
    if not SSH_USER_RE.fullmatch(user):
        return '', 'invalid ssh_user'
    return user, ''


def validate_prompt_label(raw):
    text = '' if raw is None else str(raw).strip()
    if not text:
        return '', 'Client name cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        return '', 'Client name must not contain control characters or newlines'
    if len(text) > 64:
        return '', 'Client name must be at most 64 characters'
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._ -]{0,63}', text):
        return '', 'invalid client name'
    return text, ''


def prompt_client_identification(existing_name, existing_note):
    print()
    print('Client identification')
    print('=====================')
    print()
    print('Enter a name that will help you identify this machine later.')
    print()

    name = '' if existing_name is None else str(existing_name).strip()
    if not name:
        while True:
            entered = read_prompt('Client name: ')
            name, err = validate_prompt_label(entered)
            if name:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    note = '' if existing_note is None else str(existing_note)
    if not str(existing_note or '').strip():
        entered = read_prompt('Description [optional]: ')
        note = '' if entered is None else str(entered).strip()
        if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in note):
            fail('Description must not contain control characters or newlines')
        if len(note) > 1024:
            fail('Description must be at most 1024 characters')
    return name, note


def prompt_zero_touch_ssh(existing_user, existing_port, port_explicit):
    print()
    print('SSH service setup')
    print('=================')
    print()
    print('Enter the SSH login account that already exists on the client machine.')
    print()

    user = normalize_ssh_user(existing_user)
    if not user:
        while True:
            entered = read_prompt('Client SSH user: ')
            user, err = validate_prompt_ssh_user(entered)
            if user:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    port = existing_port
    if not port_explicit:
        while True:
            entered = normalize_ssh_user(read_prompt('SSH port [22]: '))
            if not entered:
                port = 22
                break
            port = coerce_port(entered)
            if port is not None:
                break
            sys.stderr.write('ERROR: invalid SSH port; must be an integer 1-65535\n')
    return user, port


def print_client_configuration(name, note, ssh_user='', ssh_port=None):
    print()
    print('Client configuration')
    print('--------------------')
    print('Client name : %s' % (name or '(hostname after enrollment)'))
    print('Description : %s' % (note or '-'))
    if ssh_user:
        print('SSH user    : %s' % ssh_user)
        print('SSH port    : %s' % ssh_port)
        print('Target      : 127.0.0.1:%s' % ssh_port)
    print()


def resolve_zero_touch_ssh(ssh_user, ssh_port, port_explicit):
    ssh_user = normalize_ssh_user(ssh_user)
    if ssh_user:
        return ssh_user, ssh_port
    if is_interactive_stdin():
        return prompt_zero_touch_ssh('', ssh_port, port_explicit)
    fail(NONINTERACTIVE_SSH_USER_ERROR)


def print_manual(cfg, record, ttl, public_host, control_public, allocator, ca_fp, installer):
    print()
    print('Enrollment Code:')
    print('%s.%s' % (record['id'], record['secret']))
    print()
    print('Expires: %s (%s seconds)' % (record['expires_at_iso'], ttl))
    print()
    if public_host and control_public:
        print('FRP Server: %s:%s' % (public_host, control_public))
    elif public_host:
        print('FRP Server: %s' % public_host)
    if allocator:
        print('Allocator: %s' % allocator)
    if ca_fp:
        print('CA SHA256: %s' % ca_fp)

    print()
    if installer and allocator:
        env_parts = ['FRP_ALLOCATOR_URL=%s' % shell_quote(allocator)]
        if ca_fp:
            env_parts.append('FRP_ALLOCATOR_CA_SHA256=%s' % shell_quote(ca_fp))
        print('Client install:')
        print(
            'curl -fsSL %s | sudo env %s bash'
            % (shell_quote(installer), ' '.join(env_parts))
        )
        print()
        print('The enrollment code is entered interactively. It is not placed on the command line.')
    elif installer:
        print('Client install:')
        print('curl -fsSL %s | sudo bash' % shell_quote(installer))
        print()
        print('WARNING: allocator public URL is not configured.')
        print('Set FRP_ALLOCATOR_URL on the client, or re-run the server installer.')
    else:
        print('Set the client installer URL, then re-run this command:')
        print(
            '  sudo frp-set-client-installer-url '
            'https://raw.githubusercontent.com/datarelay-labs/frp-auto-deploy/v2.1.0/dist/bootstrap-client.sh'
        )
        if not allocator:
            print()
            print('WARNING: allocator public URL is not configured.')
    print()


def print_one_line(ticket, ttl, note, public_host, control_public, allocator, ca_fp, installer, ssh_user, ssh_port, client_name='', management_only=False):
    env_parts = [
        'FRP_ALLOCATOR_URL=%s' % shell_quote(allocator),
        'FRP_ALLOCATOR_CA_SHA256=%s' % shell_quote(ca_fp),
        'FRP_BOOTSTRAP_TICKET=%s' % shell_quote(ticket),
        'FRP_ZERO_TOUCH=1',
    ]
    if ssh_user:
        env_parts.append('FRP_SSH_USER=%s' % shell_quote(ssh_user))
    if ssh_port and int(ssh_port) != 22:
        env_parts.append('FRP_SSH_PORT=%s' % shell_quote(str(int(ssh_port))))
    if management_only:
        env_parts.append('FRP_MANAGEMENT_ONLY=1')
    command = 'curl -fsSL %s | sudo env %s bash' % (
        shell_quote(installer),
        ' '.join(env_parts),
    )
    print()
    print('Zero-touch client command')
    print()
    print('This command contains a short-lived one-time bootstrap ticket.')
    print('Treat the command as sensitive until it expires or is used.')
    print()
    print(command)
    print()
    print('Expires: %s (%s seconds)' % (iso(int(time.time()) + ttl), ttl))
    if client_name:
        print('Client name: %s' % client_name)
    if note:
        print('Note: %s' % note)
    if public_host and control_public:
        print('FRP Server: %s:%s' % (public_host, control_public))
    print()
    print('Send that single line to the remote user. They paste it and press Enter.')
    print('No Enrollment Code prompt or FRP configuration is required.')
    if management_only:
        print('This enrolls management identity only; no service or public port is created.')
    print()
    print('The ticket is not the FRP token. It cannot manage the client after enrollment.')
    print('It cannot be reused by another machine once bound.')
    print()


def main(argv=None):
    a = parse_args(argv)
    if a.ttl is None or int(a.ttl) <= 0:
        fail('TTL must be a positive integer')
    ttl = int(a.ttl)

    if a.ssh_user and not a.ssh:
        fail('--ssh-user requires --ssh')
    if a.ssh_port is not None and not a.ssh:
        fail('--ssh-port requires --ssh')
    if a.services_file and a.ssh:
        fail('use either --ssh or --services-file, not both')
    if (a.ssh or a.services_file) and not a.one_line:
        fail('--ssh and --services-file require --one-line')

    ssh_port = 22
    port_explicit = a.ssh_port is not None
    if port_explicit:
        ssh_port = coerce_port(a.ssh_port)
        if ssh_port is None:
            fail('invalid --ssh-port; must be an integer 1-65535')
    ssh_user = normalize_ssh_user(a.ssh_user)

    cfg = json.loads(Path(CONFIG).read_text())
    enroll_dir = remap(cfg['enrollments_dir'])
    enroll_dir.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(str(enroll_dir), 0o700)
    except OSError:
        pass

    public_host = cfg_public_host(cfg)
    control_public = cfg_frp_control_public_port(cfg)
    allocator = str(cfg.get('allocator_public_url', '') or '').strip()
    ca_path = remap(str(cfg.get('tls_ca_cert') or '/etc/frp-auto-deploy/pki/ca.crt'))
    ca_fp = fingerprint_from_cert(ca_path) if ca_path.is_file() else ''
    installer = str(cfg.get('client_installer_url', '') or '').strip()

    reject_control_chars('--note', a.note)
    reject_control_chars('--client-name', a.client_name)
    reject_control_chars('allocator public URL', allocator)
    reject_control_chars('client installer URL', installer)
    reject_control_chars('--ssh-user', ssh_user)
    client_name = str(a.client_name or '').strip()
    note = str(a.note or '')
    if client_name:
        client_name, err = validate_prompt_label(client_name)
        if err:
            fail(err)
    if len(note) > 1024:
        fail('note must be at most 1024 characters')

    if not a.one_line:
        enrollment_id = secrets.token_hex(8)
        secret = secrets.token_hex(32)
        record, _path = write_enrollment(
            enroll_dir, enrollment_id, secret, ttl, note, label=client_name
        )
        print_manual(cfg, record, ttl, public_host, control_public, allocator, ca_fp, installer)
        return 0

    if a.ssh and not ssh_user and not is_interactive_stdin():
        fail(NONINTERACTIVE_SSH_USER_ERROR)

    if not installer:
        fail(
            'client installer URL is not configured; '
            'run sudo frp-set-client-installer-url before --one-line'
        )
    if not allocator:
        fail('allocator public URL is not configured; cannot generate a zero-touch command')
    if not allocator.lower().startswith('https://'):
        fail('allocator public URL must be HTTPS')
    if not ca_fp:
        fail('allocator CA SHA256 fingerprint is not available; cannot generate a secure command')

    alloc_mod = load_allocator()
    if alloc_mod is None:
        fail('allocator module is missing')

    if is_interactive_stdin() and (not client_name or not str(a.note or '').strip()):
        client_name, note = prompt_client_identification(client_name, note)
        reject_control_chars('--client-name', client_name)
        reject_control_chars('--note', note)

    if a.ssh:
        ssh_user, ssh_port = resolve_zero_touch_ssh(ssh_user, ssh_port, port_explicit)
        reject_control_chars('--ssh-user', ssh_user)
        raw_services = [ssh_service(ssh_user, ssh_port)]
    else:
        raw_services = load_services_file(a.services_file) if a.services_file else []

    try:
        services = alloc_mod.normalize_services(raw_services)
    except alloc_mod.ServiceValidationError as exc:
        fail(str(exc))

    ssh_user, ssh_pre_port = first_ssh_preflight(services)
    print_client_configuration(client_name, note, ssh_user, ssh_pre_port)

    bootstrap_cfg = str(cfg.get('bootstrap_dir') or '').strip()
    if bootstrap_cfg:
        bootstrap_dir = remap(bootstrap_cfg)
    else:
        bootstrap_dir = enroll_dir.parent / 'bootstrap'

    try:
        ticket, _enroll_record, _ticket_record = alloc_mod.issue_bootstrap_ticket(
            enroll_dir, bootstrap_dir, services, ttl, note, label=client_name
        )
    except Exception as exc:
        fail('failed to issue bootstrap ticket: %s' % exc)

    print_one_line(
        ticket,
        ttl,
        note,
        public_host,
        control_public,
        allocator,
        ca_fp,
        installer,
        ssh_user,
        ssh_pre_port,
        client_name=client_name,
        management_only=not services,
    )
    try:
        here = Path(__file__).resolve()
        for path in (
            here.parent.parent / 'lib' / 'frp_audit.py',
            Path('/usr/local/lib/frp-auto-deploy/frp_audit.py'),
        ):
            if path.is_file():
                spec = importlib.util.spec_from_file_location('frp_audit', str(path))
                audit = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(audit)
                audit.try_emit('enrollment.created', details={'label': client_name})
                break
    except Exception:
        pass
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
