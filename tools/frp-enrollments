#!/usr/bin/env python3
"""List issued enrollment credentials without exposing secrets.

Shows both manual Enrollment Code records (enrollments_dir) and zero-touch
bootstrap tickets (bootstrap_dir). Paired zero-touch enrollment+ticket rows
are deduplicated to a single logical enrollment (the bootstrap ticket ID).
"""
import argparse
import json
import os
import time
import unicodedata
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
CONFIG = Path(ROOT + '/etc/frp-auto-deploy/config.json')


def remap(path):
    path = Path(path)
    if ROOT and not str(path).startswith(ROOT):
        return Path(ROOT + str(path))
    return path


def load_json_dir(directory):
    records = []
    if not directory.is_dir():
        return records
    for path in directory.glob('*.json'):
        try:
            rec = json.loads(path.read_text(encoding='utf-8'))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(rec, dict):
            records.append(rec)
    return records


def terminal_safe(value, limit=None, default='-'):
    """Return terminal-safe operator text without control/format characters."""
    text = str(value or '')
    cleaned = ''.join(
        ' ' if unicodedata.category(ch).startswith('C') else ch
        for ch in text
    ).strip()
    if limit is not None:
        cleaned = cleaned[:limit]
    return cleaned or default


def parse_epoch(value):
    if value in (None, ''):
        return 0, True
    try:
        return int(value), True
    except (TypeError, ValueError):
        return 0, False


def normalize_state(record, now):
    """Map authoritative record fields to a single operator-facing state."""
    if record.get('revoked_at'):
        return 'revoked'
    if record.get('completed_at'):
        return 'completed'
    if record.get('used_at'):
        return 'completed'
    expires, valid = parse_epoch(record.get('expires_at'))
    if not valid:
        return 'invalid'
    if expires and expires < now:
        return 'expired'
    if record.get('bound_machine_id'):
        return 'bound'
    return 'pending'


def fmt_created(record):
    created = str(record.get('created_at') or '').strip()
    if created:
        return terminal_safe(created.replace('+00:00', 'Z'))
    return '-'


def fmt_expires(record):
    iso = str(record.get('expires_at_iso') or '').strip()
    if iso:
        return terminal_safe(iso.replace('+00:00', 'Z'))
    expires, valid = parse_epoch(record.get('expires_at'))
    if not valid:
        return 'invalid'
    if expires:
        try:
            return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(expires))
        except (OverflowError, OSError, ValueError):
            return 'invalid'
    return '-'


def collect_rows(enrollments_dir, bootstrap_dir, now):
    """Build deduplicated listing rows."""
    bootstrap = load_json_dir(bootstrap_dir)
    paired_enrollment_ids = set()
    rows = []
    for rec in bootstrap:
        eid = str(rec.get('enrollment_id') or '').strip().lower()
        if eid:
            paired_enrollment_ids.add(eid)
        raw_id = str(rec.get('id') or '').strip().lower()
        rows.append({
            'id': terminal_safe(raw_id),
            'type': 'zero-touch',
            'label': terminal_safe(rec.get('label'), limit=24),
            'created': fmt_created(rec),
            'expires': fmt_expires(rec),
            'state': normalize_state(rec, now),
            'sort_created': terminal_safe(rec.get('created_at'), default=''),
        })
    for rec in load_json_dir(enrollments_dir):
        raw_id = str(rec.get('id') or '').strip().lower()
        if not raw_id or raw_id in paired_enrollment_ids:
            continue
        rows.append({
            'id': terminal_safe(raw_id),
            'type': 'manual',
            'label': terminal_safe(rec.get('label'), limit=24),
            'created': fmt_created(rec),
            'expires': fmt_expires(rec),
            'state': normalize_state(rec, now),
            'sort_created': terminal_safe(rec.get('created_at'), default=''),
        })
    rows.sort(key=lambda row: (row['sort_created'], row['id']))
    return rows


def main(argv=None):
    parser = argparse.ArgumentParser(
        description='List issued enrollment credentials (never displays secrets)'
    )
    parser.parse_args(argv)
    cfg = json.loads(CONFIG.read_text(encoding='utf-8'))
    enrollments = remap(cfg['enrollments_dir'])
    bootstrap = remap(
        cfg.get('bootstrap_dir')
        or str(Path(cfg['enrollments_dir']).parent / 'bootstrap')
    )
    rows = collect_rows(enrollments, bootstrap, int(time.time()))
    print(f'{"ID":<16} {"TYPE":<11} {"LABEL":<12} {"CREATED":<21} {"EXPIRES":<21} STATE')
    print('-' * 96)
    for row in rows:
        print(
            f'{row["id"]:<16} {row["type"]:<11} {row["label"]:<12} '
            f'{row["created"]:<21} {row["expires"]:<21} {row["state"]}'
        )
    if not rows:
        print('(none)')
    else:
        print()
        print('Actions:')
        print('  pending/bound:')
        print('    revoke enrollment <ID>')
        print()
        print('  expired/completed/revoked:')
        print('    purge enrollment <ID>')
    retention_days = 30
    lifecycle = None
    try:
        import importlib.util
        here = Path(__file__).resolve()
        for path in (
            here.parent.parent / 'lib' / 'frp_enrollment_lifecycle.py',
            Path('/usr/local/lib/frp-auto-deploy/frp_enrollment_lifecycle.py'),
        ):
            if path.is_file():
                spec = importlib.util.spec_from_file_location('frp_enrollment_lifecycle', str(path))
                lifecycle = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(lifecycle)
                break
        if lifecycle is not None:
            retention_days = lifecycle.retention_days_from_config(cfg)
    except Exception:
        retention_days = 30
    print()
    print('Terminal records are automatically retained for %s days.' % retention_days)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
