def print_one_line_windows(ticket, ttl, note, public_host, control_public, allocator, ca_fp, installer, rdp_port=None, client_name='', management_only=False, ticket_id='', sha256sums_url='', release_channel='', source_ref=''):
    join_url = derive_windows_join_url(installer)
    if not join_url:
        fail(
            'cannot derive windows-join.ps1 URL from Windows installer URL; '
            'use an official .../dist/bootstrap-client.ps1 path'
        )
    channel = str(release_channel or '').strip().lower()
    source_ref = str(source_ref or '').strip()
    if not channel or (channel == 'candidate' and not re.fullmatch(r'[0-9a-f]{40}', source_ref)):
        channel, source_ref = resolve_release_identity(installer)
    descriptor = encode_windows_join_descriptor(
        allocator, ca_fp, ticket, channel, source_ref, platform='windows'
    )
    # Readable two-step: download immutable launcher, then -File with Join.
    # No irm|iex, no EncodedCommand obfuscation of the full payload.
    inner = (
        "$f=$env:TEMP+'\\wj.ps1';"
        "(New-Object Net.WebClient).DownloadFile(__JOIN_URL__,$f);"
        "powershell -NoP -EP Bypass -File $f -Join __JOIN__"
    )
    inner = (
        inner
        .replace('__JOIN_URL__', ps_single_quote(join_url))
        .replace('__JOIN__', ps_single_quote(descriptor))
    )
    command = 'powershell -NoP -EP Bypass -C ' + ps_single_quote(inner)
    tracking_id = str(ticket_id or '').strip()
    if not tracking_id and ticket:
        parts = str(ticket).split('.')
        if len(parts) >= 2:
            tracking_id = parts[1]
    tools_cmd = r'C:\ProgramData\frp-auto-deploy\tools\frp-client.cmd'
    print()
    print('Zero-touch Windows client command')
    print()
    print('This command contains a short-lived one-time bootstrap ticket.')
    print('Treat the command as sensitive until it expires or is used.')
    print()
    print('Run in an elevated Windows PowerShell window (Windows 10/11 x64).')
    print()
    if tracking_id:
        print('Enrollment ID: %s' % tracking_id)
        print()
    if channel:
        print('Release channel: %s' % channel)
        if source_ref:
            print('Source ref: %s' % source_ref)
        print()
    print(command)
    print()
    print('Expires: %s (%s seconds)' % (iso(int(time.time()) + ttl), ttl))
    if client_name:
