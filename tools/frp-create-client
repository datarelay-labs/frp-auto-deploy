def resolve_enrollment_group_ids(cfg, group_queries):
    if not group_queries:
        return []
    creg = load_creg()
    if creg is None:
        fail('client registry module is missing')
    reg_path = remap(str(cfg.get('registry_file') or '/var/lib/frp-auto-deploy/registry.json'))
    state = json.loads(reg_path.read_text()) if reg_path.is_file() else {
        'schema_version': 2,
        'clients': {},
        'groups': {},
    }
    try:
        return creg.resolve_group_ids_for_assignment(state, group_queries)
    except (creg.GroupLookupError, ValueError) as exc:
        if isinstance(exc, creg.GroupLookupError) and exc.matches:
            sys.stderr.write('ERROR: multiple groups matched.\n\n')
            sys.stderr.write(creg.format_group_candidate_table(exc.matches))
        else:
            sys.stderr.write('ERROR: %s\n' % exc)
        raise SystemExit(1)


def fingerprint_from_cert(path):
    pki = load_frp_pki()
    if pki is None:
        return ''
    try:
        return pki.fingerprint_from_cert_file(path)
    except Exception:
        return ''


def shell_quote(value):
    quoted = shlex.quote(str(value))
    if quoted and quoted[0] not in ("'", '"'):
        quoted = "'" + quoted + "'"
    return quoted


def reject_control_chars(label, value):
    if value is None:
        return
    text = str(value)
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        fail('%s must not contain control characters or newlines' % label)


def fail(message, code=2):
    sys.stderr.write('ERROR: %s\n' % message)
    raise SystemExit(code)


def atomic_write_json(path, data, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write('\n')
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass
    try:
        path.chmod(mode)
    except OSError:
        pass


def write_enrollment(enroll_dir, enrollment_id, secret, ttl, note, label='', assigned_group_ids=None):
    now = int(time.time())
    record = {
        'id': enrollment_id,
        'secret': secret,
        'created_at': iso(now),
        'expires_at': now + ttl,
        'expires_at_iso': iso(now + ttl),
        'bound_machine_id': None,
        'used_at': None,
        'note': note,
        'label': label,
    }
    if assigned_group_ids:
        record['assigned_group_ids'] = list(assigned_group_ids)
    path = enroll_dir / (enrollment_id + '.json')
    atomic_write_json(path, record, 0o600)
    return record, path


