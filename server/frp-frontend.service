[Unit]
Description=FRP Auto Deploy HTTPS/WSS frontend
After=network-online.target frps.service frp-port-allocator.service
Wants=network-online.target frps.service frp-port-allocator.service

[Service]
Type=simple
# Runs as root (no User=) so the 0600 project TLS key stays non-world-readable.
# This unit uses a project-owned config and does not take over distro nginx.service.
RuntimeDirectory=frp-auto-deploy
RuntimeDirectoryMode=0700
ExecStart=/usr/sbin/nginx -c /etc/frp-auto-deploy/frontend.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# Hardening below requires systemd 232+. The installer strips these lines on
# older systemd (Amazon Linux 2 is 219) rather than failing unit load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/frp-auto-deploy /run/frp-auto-deploy /var/log/frp-auto-deploy /etc/frp-auto-deploy

[Install]
WantedBy=multi-user.target
