frpctl_input_init() {
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" && -z "${_FRP_CTL_INPUT_READY:-}" ]]; then
    _FRP_CTL_INPUT_FILE="$(mktemp)"
    printf '%s' "${FRP_CTL_TEST_INPUT}" >"$_FRP_CTL_INPUT_FILE"
    if [[ "${FRP_CTL_TEST_INPUT}" != *$'\n' ]]; then
      printf '\n' >>"$_FRP_CTL_INPUT_FILE"
    fi
    exec 9<"$_FRP_CTL_INPUT_FILE"
    _FRP_CTL_INPUT_READY=1
  fi
}

frpctl_input_cleanup() {
  if [[ -n "${_FRP_CTL_INPUT_FILE:-}" && -f "${_FRP_CTL_INPUT_FILE}" ]]; then
    rm -f "${_FRP_CTL_INPUT_FILE}"
  fi
  if [[ "${_FRP_CTL_INPUT_READY:-}" == "1" ]]; then
    exec 9<&- 2>/dev/null || true
  fi
  _FRP_CTL_INPUT_READY=""
  _FRP_CTL_INPUT_FILE=""
}

# Returns 1 on EOF. Empty Enter is a successful empty string.
frpctl_try_read() {
  local prompt="$1"
  local value=""
  frpctl_input_init
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    if ! IFS= read -r value <&9; then
      return 1
    fi
  elif [[ -t 0 ]]; then
    if ! IFS= read -r -p "$prompt" value; then
      return 1
    fi
  else
    echo "ERROR: no TTY for interactive menu; pass a command such as: frpctl status" >&2
    return 1
  fi
  printf '%s' "$value"
  return 0
}

frpctl_read() {
  local prompt="$1" default="${2:-}"
  local value=""
  if ! value="$(frpctl_try_read "$prompt")"; then
    return 1
  fi
  if [[ -z "$value" ]]; then
    value="$default"
  fi
  printf '%s' "$value"
}

frpctl_client_menu() {
  local choice
  while true; do
    echo
    frpctl_header
    frpctl_print_client_menu
    echo
    if [[ "${FRP_CTL_TEST_MENU:-}" == "1" ]]; then
      return 0
    fi
    choice="$(frpctl_read "Select: " "")" || return 1
    case "$choice" in
      1) frpctl_run frp-client ;;
      2) frpctl_run frp-client status ;;
      3) frpctl_run frp-client info ;;
      4) frpctl_client_update ;;
      5) frpctl_dispatch doctor || true ;;
      6) frpctl_usage ;;
      7)
        echo "Exit."
        return 0
        ;;
      *) echo "ERROR: select 1-7" >&2 ;;
    esac
  done
}

frpctl_guided_enroll() {
  local choice
  echo
  echo "Create enrollment"
  echo "================="
  echo
  echo "1) Zero-touch SSH (recommended)"
  echo "2) Manual Enrollment Code"
  echo "3) Back"
  echo
  choice="$(frpctl_read "Select: " "")" || return 1
  case "$choice" in
    1)
      frpctl_run frp-create-client --one-line --ssh
      ;;
    2)
      frpctl_run frp-create-client
      ;;
    3|"")
      return 0
      ;;
    *)
      echo "ERROR: select 1-3" >&2
      return 1
      ;;
  esac
}

frpctl_print_manage_client_actions() {
  echo "Actions"
  echo
  echo "1. Change label"
  echo "2. Edit description"
  echo "3. Show connection information"
  echo "4. View services"
  echo "5. Revoke management access"
  echo "6. Release service"
  echo "7. Release client"
  echo "8. Back"
}

frpctl_manage_one_client() {
  local mid="$1" action sid label note
  while true; do
    echo
    echo "FRP Auto Deploy — Client Management"
    echo "==================================="
    echo
    frpctl_run frp-client-info "$mid" || return 1
    echo
    frpctl_print_manage_client_actions
    echo
    action="$(frpctl_read "Select: " "")" || return 1
    case "$action" in
      1)
        label="$(frpctl_read "New label: " "")"
        if [[ -z "$label" ]]; then
          echo "ERROR: label is required" >&2
          continue
        fi
        frpctl_run frp-client-set "$mid" --label "$label" || true
        ;;
      2)
        note="$(frpctl_read "New description: " "")"
        frpctl_run frp-client-set "$mid" --note "$note" || true
        ;;
      3)
        frpctl_run frp-client-info "$mid" || true
        ;;
      4)
        frpctl_run frp-clients || true
        ;;
      5)
        frpctl_run frp-revoke-client "$mid" || true
        ;;
      6)
        sid="$(frpctl_read "Service ID: " "")"
        if [[ -z "$sid" ]]; then
          echo "ERROR: service ID is required" >&2
          continue
        fi
        frpctl_run frp-release-service "$mid" "$sid" || true
        ;;
      7)
        frpctl_run frp-release-client "$mid" || true
        return 0
        ;;
      8|"")
        return 0
        ;;
      *)
        echo "ERROR: select 1-8" >&2
        ;;
    esac
  done
}

frpctl_manage_clients() {
  local cfg root choice mid libdir
  cfg="$(frpctl_path /etc/frp-auto-deploy/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  libdir="${_FRPCTL_DIR}/../lib"
  echo
  echo "FRP Auto Deploy — Client Management"
  echo "==================================="
  echo
  python3 - "$cfg" "$root" "$libdir" <<'PY'
import importlib.util
import json
import sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
libdir = Path(sys.argv[3])
search = []
if root:
    search.append(Path(root) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py')
search.append(libdir / 'frp_client_registry.py')
search.append(Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'))
mod = None
for path in search:
    if path.is_file():
        spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        break
if mod is None:
    sys.stderr.write('ERROR: missing frp_client_registry.py\n')
    raise SystemExit(1)
if not cfg_path.is_file():
    print('(no registered clients)')
    raise SystemExit(0)
cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
reg = Path(str(cfg.get('registry_file') or ''))
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
state = json.loads(reg.read_text(encoding='utf-8')) if reg.is_file() else {'clients': {}}
clients = mod.sorted_clients(state)
if not clients:
    print('(no registered clients)')
    raise SystemExit(0)
for idx, (mid, client) in enumerate(clients, start=1):
    print('%s. %s' % (idx, mod.sanitize_display(mod.display_name(client, mid))))
    print('   Hostname : %s' % mod.sanitize_display(client.get('hostname') or '-'))
    print('   ID       : %s' % mod.short_machine_id(mid))
    print('   State    : %s' % mod.mgmt_status(client))
    print()
PY
  choice="$(frpctl_read "Select client number: " "")" || return 1
  [[ -n "$choice" ]] || return 0
  mid="$(python3 - "$cfg" "$root" "$libdir" "$choice" <<'PY'
import importlib.util
import json
import sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
libdir = Path(sys.argv[3])
choice = sys.argv[4].strip()
search = []
if root:
    search.append(Path(root) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py')
search.append(libdir / 'frp_client_registry.py')
search.append(Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'))
mod = None
for path in search:
    if path.is_file():
        spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        break
if mod is None:
    raise SystemExit(1)
cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
reg = Path(str(cfg.get('registry_file') or ''))
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
state = json.loads(reg.read_text(encoding='utf-8'))
clients = mod.sorted_clients(state)
if not choice.isdigit():
    raise SystemExit(1)
idx = int(choice)
if idx < 1 or idx > len(clients):
    raise SystemExit(1)
print(clients[idx - 1][0])
PY
)" || {
    echo "ERROR: invalid client number" >&2
    return 1
  }
  [[ -n "$mid" ]] || return 1
  frpctl_manage_one_client "$mid"
}

frpctl_server_menu() {
  local choice client sid
  while true; do
    echo
    frpctl_header
    frpctl_print_server_menu
    echo
    if [[ "${FRP_CTL_TEST_MENU:-}" == "1" ]]; then
      return 0
    fi
    choice="$(frpctl_read "Select: " "")" || return 1
    case "$choice" in
      1) frpctl_run frp-server-status ;;
      2) frpctl_run frp-clients ;;
      3) frpctl_manage_clients ;;
      4) frpctl_guided_enroll ;;
      5)
        client="$(frpctl_read "Client name: " "")"
        if [[ -z "$client" ]]; then
          echo "ERROR: client name is required" >&2
          continue
        fi
        frpctl_run frp-client-info "$client"
        ;;
      6)
        client="$(frpctl_read "Client name: " "")"
        if [[ -z "$client" ]]; then
          echo "ERROR: client name is required" >&2
          continue
        fi
        frpctl_run frp-revoke-client "$client"
        ;;
      7)
        client="$(frpctl_read "Client name: " "")"
        sid="$(frpctl_read "Service ID: " "")"
        if [[ -z "$client" || -z "$sid" ]]; then
          echo "ERROR: client name and service ID are required" >&2
          continue
        fi
        frpctl_run frp-release-service "$client" "$sid"
        ;;
      8)
        client="$(frpctl_read "Client name: " "")"
        if [[ -z "$client" ]]; then
          echo "ERROR: client name is required" >&2
          continue
        fi
        frpctl_run frp-release-client "$client"
        ;;
      9) frpctl_run frp-update ;;
      10) frpctl_dispatch doctor || true ;;
      11) frpctl_usage ;;
      12)
        echo "Exit."
        return 0
        ;;
      *) echo "ERROR: select 1-12" >&2 ;;
    esac
  done
}

