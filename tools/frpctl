#!/usr/bin/env bash
# Unified operator entry point for frp-auto-deploy.
# Thin dispatcher over existing commands. Does not reimplement registry or
# client-state mutations.
set -euo pipefail

_FRPCTL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_FRPCTL_DIR}/../lib/frp-doctor-common.sh" ]]; then
  # shellcheck source=../lib/frp-doctor-common.sh
  . "${_FRPCTL_DIR}/../lib/frp-doctor-common.sh"
elif [[ -f /usr/local/lib/frp-auto-deploy/frp-doctor-common.sh ]]; then
  # shellcheck disable=SC1091
  . /usr/local/lib/frp-auto-deploy/frp-doctor-common.sh
fi

frpctl_path() {
  local p="$1"
  local root="${FRP_CTL_TEST_ROOT:-${FRP_CLIENT_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-${FRP_UPDATE_ROOT:-}}}}"
  if [[ -n "$root" ]]; then
    printf '%s' "${root}${p}"
  else
    printf '%s' "$p"
  fi
}

frpctl_is_client() {
  if [[ -f "$(frpctl_path /etc/frp/client-state.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/frpc.toml)" && -f "$(frpctl_path /etc/frp/client-identity.key)" ]]; then
    return 0
  fi
  return 1
}

frpctl_is_server() {
  if [[ -f "$(frpctl_path /etc/frp-auto-deploy/config.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/server_token)" && -f "$(frpctl_path /var/lib/frp-auto-deploy/registry.json)" ]]; then
    return 0
  fi
  return 1
}

frpctl_read_kv() {
  local file="$1" key="$2"
  if [[ ! -f "$file" ]]; then
    return 0
  fi
  awk -F= -v k="$key" '$1==k {print substr($0, index($0,"=")+1); exit}' "$file"
}

frpctl_project_version() {
  local pv
  pv="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" PROJECT_VERSION)"
  if [[ -z "$pv" ]]; then
    printf '%s' "legacy / unknown"
    return 0
  fi
  printf '%s' "$pv"
}

frpctl_frp_version() {
  local fv
  fv="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" FRP_VERSION)"
  if [[ -n "$fv" ]]; then
    printf '%s' "$fv"
    return 0
  fi
  printf '%s' "0.70.1"
}

frpctl_release_channel() {
  local ch
  ch="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" RELEASE_CHANNEL)"
  if [[ -z "$ch" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$ch"
}

frpctl_source_ref() {
  local ref
  ref="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" SOURCE_REF)"
  if [[ -z "$ref" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$ref"
}

frpctl_bundle_sha256() {
  local sha
  sha="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" BUNDLE_SHA256)"
  if [[ -z "$sha" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$sha"
}

frpctl_role_label() {
  local client=0 server=0
  frpctl_is_client && client=1
  frpctl_is_server && server=1
  if [[ "$client" == "1" && "$server" == "1" ]]; then
    printf '%s' "Client + Server"
  elif [[ "$client" == "1" ]]; then
    printf '%s' "Client"
  elif [[ "$server" == "1" ]]; then
    printf '%s' "Server"
  else
    printf '%s' "unknown"
  fi
}

frpctl_require_install() {
  if frpctl_is_client || frpctl_is_server; then
    return 0
  fi
  echo "ERROR: no FRP Auto Deploy installation was found on this host." >&2
  echo "Install the server or client bootstrap first." >&2
  return 1
}

frpctl_find_cmd() {
  local name="$1" cand
  if [[ -n "${FRP_CTL_BIN_DIR:-}" ]]; then
    cand="${FRP_CTL_BIN_DIR}/${name}"
    if [[ -e "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  fi
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for cand in "/usr/local/sbin/${name}" "/usr/local/bin/${name}"; do
    if [[ -x "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  echo "ERROR: command not found: ${name}" >&2
  echo "This host does not have that frp-auto-deploy command installed." >&2
  return 1
}

frpctl_run() {
  local name="$1"
  shift
  local bin rc
  bin="$(frpctl_find_cmd "$name")" || return 1
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    if [[ $# -gt 0 ]]; then
      printf 'DISPATCH %s' "$name"
      printf ' %s' "$@"
      printf '\n'
    else
      printf 'DISPATCH %s\n' "$name"
    fi
    return 0
  fi
  "$bin" "$@"
  rc=$?
  return "$rc"
}

frpctl_exec() {
  local name="$1"
  shift
  local bin
  bin="$(frpctl_find_cmd "$name")" || return 1
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    if [[ $# -gt 0 ]]; then
      printf 'DISPATCH %s' "$name"
      printf ' %s' "$@"
      printf '\n'
    else
      printf 'DISPATCH %s\n' "$name"
    fi
    return 0
  fi
  exec "$bin" "$@"
}

# Direct mode may replace the process. Persistent-shell mode must return.
frpctl_invoke() {
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    frpctl_run "$@"
  else
    frpctl_exec "$@"
  fi
}

frpctl_usage() {
  cat <<'EOF'
Usage: frpctl [command] [args]

frpctl is the everyday frp-auto-deploy command. For normal operation,
this is the only command you need to remember:

    sudo frpctl

With no arguments and a TTY, that starts the persistent management CLI.
Type 'help' or '?' inside the CLI for role-specific commands. Press Tab
to complete commands (and, on a server, client names and service IDs).
Type 'menu' for the guided numbered menu.

Direct commands remain available for scripts, automation, and advanced use.

Common commands:
  (no args)          Persistent interactive CLI (requires a TTY)
  menu               Open the guided numbered menu
  status             Show a quick operational summary for this host's role
  doctor             Run read-only health and consistency checks
  version            Show installed versions (no network)
  update             Server: pinned FRP binary. Client: project tools.
  help               Show this help

Client commands:
  manage             Open client service management (frp-client)
  services           List configured services
  info               Show connection information

Server commands:
  clients            List registered clients
  client NAME        Show one client's connection information
  enroll             Create a short-lived Enrollment Code
  create-client      Same as enroll
  client-info NAME   Same as client
  client-set NAME    Set administrator label/description
  edit-client NAME   Same as client-set
  revoke NAME        Revoke a client's management identity
  revoke-client NAME Same as revoke
  release-service NAME ID
                     Release one service reservation
  release-client NAME
                     Release every reservation for a client

Official upstream FRP binaries are frps (server) and frpc (client).
Commands such as frpctl, frp-client, frp-clients, and frp-update belong
to this frp-auto-deploy operational layer. This project does not fork FRP.

Existing commands remain available for scripts and advanced use.
EOF
}

