# Load canonical grammar "passthrough" into _FRP_CTL_ARGS as a true argv array.
# NUL-delimited Python → Bash transport preserves spaces, quotes, wildcards,
# leading dashes, and empty arguments. Bash 3.2 compatible (no mapfile/nameref).
# Bash <4.4 + set -u treats "${empty[@]}" as unbound; use ${arr[@]+"${arr[@]}"}.
_FRP_CTL_ARGS=()
frpctl_load_passthrough_args() {
  local json="$1"
  local arg
  _FRP_CTL_ARGS=()
  while IFS= read -r -d '' arg; do
    _FRP_CTL_ARGS+=("$arg")
  done < <(
    python3 -c '
import json, sys
for item in json.loads(sys.argv[1]).get("passthrough") or []:
    sys.stdout.write(item)
    sys.stdout.write("\0")
' "$json"
  )
}

frpctl_dispatch_canonical() {
  local extra result status action
  _FRP_CTL_RC=0
  extra="$(python3 -c 'import json,sys; print(json.dumps({"tokens":sys.argv[1:]}))' "$@")"
  result="$(frpctl_grammar_call match "$extra")" || return 1
  status="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("status",""))' "$result")"
  case "$status" in
    empty|legacy|unknown)
      return 1
      ;;
    shell)
      frpctl_reject_shell
      _FRP_CTL_RC=$?
      return 0
      ;;
    role)
      echo "ERROR: that command is not available on this host role." >&2
      _FRP_CTL_RC=1
      return 0
      ;;
    incomplete)
      frpctl_print_grammar_help "$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("message",""))' "$result")"
      return 0
      ;;
    error)
      echo "ERROR: $(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("message",""))' "$result")" >&2
      _FRP_CTL_RC=1
      return 0
      ;;
    ok)
      ;;
    *)
      return 1
      ;;
  esac
  action="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("action",""))' "$result")"
  _FRP_CTL_CANON="$result"
  set +e
