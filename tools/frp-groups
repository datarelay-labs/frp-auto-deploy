#!/usr/bin/env python3
"""List and show server-owned manual client groups."""
import argparse
import importlib.util
import json
import os
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path(ROOT) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py' if ROOT else None,
        Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'),
    ]
    for path in candidates:
        if path is not None and path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()


def load_state():
    cfg = json.loads(Path(ROOT + '/etc/frp-auto-deploy/config.json').read_text())
    reg = Path(cfg['registry_file'])
    if ROOT and not str(reg).startswith(ROOT):
        reg = Path(ROOT + str(reg))
    state = json.loads(reg.read_text()) if reg.exists() else {
        'schema_version': 2, 'clients': {}, 'groups': {},
    }
    if state.get('schema_version') != 2:
        raise SystemExit('ERROR: unsupported registry schema version')
    try:
        CREG.ensure_groups_map(state)
    except ValueError as exc:
        raise SystemExit('ERROR: %s' % exc)
    return state


def list_groups(state):
    print('%-14s %-24s %7s' % ('GROUP ID', 'NAME', 'CLIENTS'))
    print('-' * 48)
    for name in (CREG.SYSTEM_GROUP_ALL, CREG.SYSTEM_GROUP_UNGROUPED):
        print('%-14s %-24s %7d' % ('-', name, CREG.group_member_count(state, name)))
    for gid, group in CREG.sorted_groups(state):
        print('%-14s %-24s %7d' % (
            CREG.sanitize_display(gid, 14),
            CREG.sanitize_display(group.get('name') or '-', 24),
            CREG.group_member_count(state, gid),
        ))


def show_group(state, selector):
    gid, group = CREG.resolve_group_or_exit(state, selector)
    print('Group ID      : %s' % ('-' if gid in CREG.RESERVED_GROUP_NAMES else gid))
    print('Name          : %s' % CREG.sanitize_display(group.get('name') or '-', 64))
    print('Description   : %s' % (
        CREG.sanitize_display(group.get('description') or '-', 1024) or '-'
    ))
    print('Client count  : %s' % CREG.group_member_count(state, gid))


def main():
    parser = argparse.ArgumentParser(description='Show manual client groups')
    parser.add_argument('selector', nargs='?')
    args = parser.parse_args()
    state = load_state()
    if args.selector:
        show_group(state, args.selector)
    else:
        list_groups(state)


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        pass
