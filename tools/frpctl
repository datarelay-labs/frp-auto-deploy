# Print matching completion candidates, one per line.
# Preserve grammar order (e.g. zero-touch before enrollment). Deduplicate only.
frpctl_completion_candidates() {
  local line="$1" extra
  extra="$(python3 -c 'import json,sys; print(json.dumps({"line":sys.argv[1]}))' "$line")"
  frpctl_grammar_call complete "$extra" | awk 'NF && !seen[$0]++'
}

frpctl_common_prefix() {
  local prefix="$1"
  shift || true
  local s
  [[ $# -gt 0 ]] || { printf '%s' "$prefix"; return 0; }
  for s in "$@"; do
    while [[ -n "$prefix" && "$s" != "$prefix"* ]]; do
      prefix="${prefix%?}"
    done
  done
  printf '%s' "$prefix"
}

frpctl_line_with_token() {
  local line="$1"
  local token="$2"
  local add_space="${3:-1}"
  local trailing=0 lastc i
  local -a words=()
  local new=""
  if [[ -n "$line" ]]; then
    lastc="${line: -1}"
    if [[ "$lastc" == " " || "$lastc" == $'\t' ]]; then
      trailing=1
    fi
  fi
  if [[ -n "${line//[[:space:]]/}" ]]; then
    IFS=$' \t' read -r -a words <<< "$line" || true
  fi
  if [[ ${#words[@]} -eq 0 || ( ${#words[@]} -eq 1 && "$trailing" == "0" ) ]]; then
    new="$token"
  elif [[ "$trailing" == "1" ]]; then
    new="${line%"${line##*[![:space:]]}"}"
    new="${new} ${token}"
  else
    new="${words[0]}"
    if [[ ${#words[@]} -gt 1 ]]; then
      for (( i=1; i<${#words[@]}-1; i++ )); do
        new+=" ${words[i]}"
      done
      new+=" ${token}"
    fi
  fi
  if [[ "$add_space" == "1" ]]; then
    new+=" "
  fi
  printf '%s' "$new"
}

# Apply unique/common-prefix completion. Prints the resulting line.
frpctl_complete_line() {
  local line="$1" extra
  extra="$(python3 -c 'import json,sys; print(json.dumps({"line":sys.argv[1]}))' "$line")"
  frpctl_grammar_call complete-line "$extra"
}

frpctl_tab_reset() {
