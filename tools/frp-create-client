def ps_single_quote(value):
    """PowerShell single-quoted string; double embedded single quotes."""
    return "'" + str(value).replace("'", "''") + "'"


def derive_sha256sums_url(installer_url):
    url = str(installer_url or '').strip()
    for suffix in (
        '/dist/bootstrap-client.ps1',
        '/dist/bootstrap-client.sh',
        '/dist/windows-join.ps1',
    ):
        if url.endswith(suffix):
            return url[: -len(suffix)] + '/SHA256SUMS'
    return ''


def derive_windows_join_url(installer_url):
    url = str(installer_url or '').strip()
    if url.endswith('/dist/bootstrap-client.ps1'):
        return url[: -len('/dist/bootstrap-client.ps1')] + '/dist/windows-join.ps1'
    if url.endswith('/dist/windows-join.ps1'):
        return url
    return ''


def parse_managed_installer_ref(installer_url):
    """Return git ref when URL is project-managed raw GitHub installer/join URL."""
    url = str(installer_url or '').strip()
    try:
        from urllib.parse import unquote, urlsplit
        parsed = urlsplit(url)
    except Exception:
        return ''
    if parsed.scheme != 'https':
        return ''
    host = (parsed.hostname or '').lower()
    if host != 'raw.githubusercontent.com':
        return ''
    if parsed.username is not None or parsed.password is not None:
        return ''
    if parsed.port not in (None, 443):
        return ''
    if parsed.query or parsed.fragment:
        return ''
    parts = [unquote(part) for part in parsed.path.split('/') if part]
    if len(parts) != 5:
        return ''
    owner, repo, ref, dist, name = parts
    if owner != 'datarelay-labs' or repo != 'frp-auto-deploy' or dist != 'dist':
        return ''
    if name not in (
        'bootstrap-client.sh',
        'bootstrap-client.ps1',
        'windows-join.ps1',
    ):
        return ''
    if ref == 'main':
        return ref
    if re.fullmatch(r'v\d+\.\d+\.\d+', ref):
        return ref
    if re.fullmatch(r'[0-9a-f]{40}', ref):
        return ref
    return ''


def read_persisted_release_identity():
    path = remap('/etc/frp-auto-deploy/version')
    channel = ''
    source_ref = ''
    if not path.is_file():
        return channel, source_ref
    try:
        for line in path.read_text(encoding='utf-8').splitlines():
            line = line.strip()
            if line.startswith('RELEASE_CHANNEL='):
                channel = line.split('=', 1)[1].strip()
            elif line.startswith('SOURCE_REF='):
                source_ref = line.split('=', 1)[1].strip()
    except OSError:
        return '', ''
    return channel, source_ref


def resolve_release_identity(installer_url):
    """
    Resolve channel + source_ref for generated zero-touch commands.
    Prefer persisted server version identity; fall back to managed installer URL ref.
    """
    channel, source_ref = read_persisted_release_identity()
    channel = str(channel or '').strip().lower()
    source_ref = str(source_ref or '').strip()
    if channel in ('stable', 'dev', 'candidate') and (
        channel != 'candidate' or re.fullmatch(r'[0-9a-f]{40}', source_ref)
    ):
        if channel == 'dev' and not source_ref:
            source_ref = 'main'
        if channel == 'stable' and not source_ref:
            source_ref = ''
        return channel, source_ref

    ref = parse_managed_installer_ref(installer_url)
    if re.fullmatch(r'[0-9a-f]{40}', ref or ''):
        return 'candidate', ref
    if ref == 'main':
        return 'dev', 'main'
    if re.fullmatch(r'v\d+\.\d+\.\d+', ref or ''):
        return 'stable', ref
    return '', ''


def encode_join_descriptor(allocator, ca_fp, ticket, channel, source_ref):
    """Compact opaque join credential (not command obfuscation).

    Wire format: frpj1.<urlsafe-b64(pipe-separated fields)>
    Fields: allocator|ca|ticket|channel|source_ref

    Shared by windows-join.ps1 and `sudo frpctl join` on macOS. The platform is
    implied by the launcher that consumes it, so it is not part of the payload.
    """
    import base64
    fields = [
        str(allocator),
        str(ca_fp).lower(),
        str(ticket),
        str(channel or ''),
        str(source_ref or ''),
    ]
    for field in fields:
        if '|' in field or '\n' in field or '\r' in field:
            fail('join field contains illegal separator')
    raw = '|'.join(fields).encode('utf-8')
    b64 = base64.urlsafe_b64encode(raw).decode('ascii').rstrip('=')
    return 'frpj1.' + b64


def encode_windows_join_descriptor(allocator, ca_fp, ticket, channel, source_ref, platform='windows'):
    _ = platform  # retained for call-site compatibility
    return encode_join_descriptor(allocator, ca_fp, ticket, channel, source_ref)


def load_services_file(path):
    raw_path = Path(path)
    if not raw_path.is_file():
        fail('services file is missing: %s' % path)
    try:
        data = json.loads(raw_path.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError):
        fail('services file is not valid JSON')
    if not isinstance(data, list):
        fail('services file must contain a JSON list')
    return data


def first_ssh_preflight(services):
    for item in services:
        if not isinstance(item, dict):
            continue
        if str(item.get('preset') or '').strip().lower() != 'ssh':
            continue
        user = str(item.get('ssh_user') or '').strip()
        port = coerce_port(item.get('local_port')) or 22
        return user, port
    return '', 22


def is_interactive_stdin():
    if 'FRP_CREATE_CLIENT_TEST_INPUT' in os.environ:
        return True
    try:
        return sys.stdin.isatty()
    except Exception:
        return False


def test_input_lines():
    global _TEST_INPUT_LINES
    if _TEST_INPUT_LINES is None:
        raw = os.environ.get('FRP_CREATE_CLIENT_TEST_INPUT')
        if raw is None:
            _TEST_INPUT_LINES = False
        else:
            _TEST_INPUT_LINES = iter(raw.splitlines())
    return _TEST_INPUT_LINES


def read_prompt(prompt):
    lines = test_input_lines()
    if lines is not False:
        sys.stdout.write(prompt)
        sys.stdout.flush()
        try:
            value = next(lines)
        except StopIteration:
            fail('required interactive input was not completed')
        sys.stdout.write(value + '\n')
        sys.stdout.flush()
        return value
    try:
        return input(prompt)
    except EOFError:
        fail('required interactive input was not completed')


def normalize_ssh_user(raw):
    if raw is None:
        return ''
    return str(raw).strip()


def validate_prompt_ssh_user(raw):
    user = normalize_ssh_user(raw)
    if not user:
        return '', 'SSH username cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in user):
        return '', 'SSH username must not contain control characters or newlines'
    if not SSH_USER_RE.fullmatch(user):
        return '', 'invalid ssh_user'
    return user, ''


def validate_prompt_label(raw):
    text = '' if raw is None else str(raw).strip()
    if not text:
        return '', 'Client name cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        return '', 'Client name must not contain control characters or newlines'
    if len(text) > 64:
        return '', 'Client name must be at most 64 characters'
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._ -]{0,63}', text):
        return '', 'invalid client name'
    return text, ''


def prompt_client_identification(existing_name, existing_note):
    print()
    print('Client identification')
    print('=====================')
    print()
    print('Enter a name that will help you identify this machine later.')
    print()

    name = '' if existing_name is None else str(existing_name).strip()
    if not name:
        while True:
            entered = read_prompt('Client name: ')
            name, err = validate_prompt_label(entered)
            if name:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    note = '' if existing_note is None else str(existing_note)
    if not str(existing_note or '').strip():
        entered = read_prompt('Description [optional]: ')
        note = '' if entered is None else str(entered).strip()
        if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in note):
            fail('Description must not contain control characters or newlines')
        if len(note) > 1024:
            fail('Description must be at most 1024 characters')
    return name, note


def prompt_zero_touch_ssh(existing_user, existing_port, port_explicit):
    print()
    print('SSH service setup')
    print('=================')
    print()
    print('Enter the SSH login account that already exists on the client machine.')
    print()

    user = normalize_ssh_user(existing_user)
    if not user:
        while True:
            entered = read_prompt('Client SSH user: ')
            user, err = validate_prompt_ssh_user(entered)
            if user:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    port = existing_port
    if not port_explicit:
        while True:
            entered = normalize_ssh_user(read_prompt('SSH port [22]: '))
            if not entered:
                port = 22
                break
            port = coerce_port(entered)
            if port is not None:
                break
            sys.stderr.write('ERROR: invalid SSH port; must be an integer 1-65535\n')
    return user, port


