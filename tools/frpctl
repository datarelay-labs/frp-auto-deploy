    help)
      frpctl_load_passthrough_args "$result"
      if [[ "${FRP_CTL_REPL:-}" == "1" || ${#_FRP_CTL_ARGS[@]} -gt 0 ]]; then
        frpctl_repl_help ${_FRP_CTL_ARGS[@]+"${_FRP_CTL_ARGS[@]}"}
      else
