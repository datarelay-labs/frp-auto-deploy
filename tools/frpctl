  # Bash filename completion cannot become the fallback.
  if [[ "${FRP_CTL_DISABLE_TAB:-}" == "1" ]]; then
    return 0
  fi
  if (( BASH_VERSINFO[0] < 4 )); then
    return 0
  fi
  if bind -x '"\t": frpctl_readline_complete' 2>/dev/null; then
    bind 'set disable-completion on' 2>/dev/null || true
    _FRP_CTL_BOUND_TAB=1
  fi
}

frpctl_repl_disable_completion() {
