#!/usr/bin/env python3
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path('/usr/local/lib/frp-auto-deploy/frp_client_registry.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/frp-auto-deploy/frp_client_registry.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()


def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        version = 1
        if isinstance(state, dict) and 'schema_version' in state:
            version = state.get('schema_version')
        raise SystemExit(
            f'ERROR: unsupported registry schema version {version}.\n\n'
            'This release requires registry schema version 2.\n\n'
            'Back up the existing registry and redeploy/reset it explicitly before continuing.'
        )
    for client in (state.get('clients') or {}).values():
        if not isinstance(client, dict):
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'This release requires registry schema version 2.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )
        if 'ssh_port' in client or 'https_port' in client:
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'Legacy SSH/HTTPS fields are present. This release requires the generic multi-service registry.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )


if len(sys.argv) not in (2, 3):
    print(f'Usage: {sys.argv[0]} <client-id|label|hostname> [overview|services|tags|groups]', file=sys.stderr)
    sys.exit(2)

q = sys.argv[1]
view = (sys.argv[2] if len(sys.argv) > 2 else 'overview').strip().lower()
if view in ('', 'info'):
    view = 'overview'
if view not in ('overview', 'services', 'tags', 'groups'):
    print('ERROR: unknown view. Use overview, services, tags, or groups.', file=sys.stderr)
    sys.exit(2)

cfg = json.loads(Path(ROOT + '/etc/frp-auto-deploy/config.json').read_text())
reg = Path(cfg['registry_file'])
if ROOT and not str(reg).startswith(ROOT):
    reg = Path(ROOT + str(reg))
state = json.loads(reg.read_text())
require_v2(state)

mid, client = CREG.resolve_client_or_exit(state, q)
all_mids = list((state.get('clients') or {}))
public_ip = CREG.sanitize_display(cfg.get('public_host') or cfg.get('public_ip') or '', 253)
services = client.get('services') or {}
if not isinstance(services, dict):
    services = {}
enabled = CREG.enabled_services(client)
label = CREG.sanitize_display(client.get('label') or '-')
hostname = CREG.sanitize_display(client.get('hostname') or '-')
note = CREG.sanitize_display(client.get('note') or '')
cid = CREG.sanitize_display(CREG.unique_short_id(mid, all_mids), 16)
tags = client.get('tags') or {}
if not isinstance(tags, dict):
    tags = {}
try:
    membership = CREG.normalize_group_ids(client.get('group_ids'))
except ValueError:
    membership = []
manual_groups, dynamic_groups = CREG.client_group_memberships(state, client)
groups_map = {}
try:
    groups_map = CREG.ensure_groups_map(state)
except ValueError:
    groups_map = {}


def print_overview():
    cfg_path = Path(ROOT + '/etc/frp-auto-deploy/config.json')
    cfg = json.loads(cfg_path.read_text()) if cfg_path.is_file() else {}
    stale_sec = 30 * 86400
    try:
        stale_sec = int(cfg.get('client_stale_days', 30)) * 86400
    except (TypeError, ValueError):
        stale_sec = 30 * 86400
    expected = CREG.load_server_version_metadata(ROOT or None)
    act = CREG.mgmt_activity_class(client, stale_sec)
    drift = CREG.build_drift_class(client, expected)
    print('Client ID      : %s' % cid)
    print('Machine ID     : %s' % CREG.sanitize_display(mid, 128))
    print('Label          : %s' % (label or '-'))
    print('Hostname       : %s' % (hostname or '-'))
    print('Management     : %s' % CREG.mgmt_status(client))
    print('Mgmt activity  : %s' % act)
    print('Last mgmt seen : %s' % CREG.sanitize_display(client.get('last_mgmt_seen_at') or '-'))
    print('Last source IP : %s' % CREG.sanitize_display(client.get('last_source_ip') or '-'))
    print('Last seen      : %s' % CREG.sanitize_display(client.get('last_seen_at') or '-'))
    print('Last enrolled  : %s' % CREG.sanitize_display(client.get('last_enrolled_at') or '-'))
    print('Reported project build : %s' % CREG.sanitize_display(client.get('reported_project_version') or '-'))
    print('Reported FRP version   : %s' % CREG.sanitize_display(client.get('reported_frp_version') or '-'))
    print('Build reported at      : %s' % CREG.sanitize_display(client.get('build_reported_at') or '-'))
    print('Build status           : %s' % drift)
    print('Description    : %s' % (note or '-'))
    print('Service count  : %s' % len(enabled))
    print('Tag count      : %s' % len(tags))
    print('Group count    : %s' % (len(manual_groups) + len(dynamic_groups)))


def print_services():
    print('%-10s %-6s %-14s %-22s %s' % ('SERVICE', 'TYPE', 'TARGET', 'PUBLIC', 'STATE'))
    if not services:
        print('(no services)')
        return
    for sid, svc in sorted(
        services.items(),
        key=lambda kv: (kv[1].get('remote_port') or 0, kv[0]) if isinstance(kv[1], dict) else (0, kv[0]),
    ):
        if not isinstance(svc, dict):
            continue
        if svc.get('enabled', True) is False:
            continue
        protocol = str(svc.get('protocol') or 'tcp').upper()
        local_ip = CREG.sanitize_display(svc.get('local_ip') or '-', 64)
        local_port = svc.get('local_port') or '-'
        remote_port = svc.get('remote_port') or '-'
        enabled_flag = 'enabled' if svc.get('enabled', True) is not False else 'disabled'
        sid_txt = CREG.sanitize_display(sid, 10)
        target = '%s:%s' % (local_ip, local_port)
        public = '%s:%s' % (public_ip or 'host', remote_port)
        print('%-10s %-6s %-14s %-22s %s' % (
            sid_txt, protocol, target[:14], public[:22], enabled_flag,
        ))
    ssh_sid, ssh = CREG.first_ssh_service(client)
    rdp_items = []
    for sid, svc in sorted(
        services.items(),
        key=lambda kv: (kv[1].get('remote_port') or 0, kv[0]) if isinstance(kv[1], dict) else (0, kv[0]),
    ):
        if not isinstance(svc, dict):
            continue
        if svc.get('enabled', True) is False:
            continue
        preset = str(svc.get('preset') or '').strip().lower()
        if preset == 'rdp' or (preset == 'custom' and int(svc.get('local_port') or 0) == 3389 and str(sid).lower() == 'rdp'):
            rdp_items.append((sid, svc))
    if ssh or rdp_items:
        print()
        print('Connect:')
        if ssh:
            if ssh.get('ssh_user'):
                print('  ssh -p %s %s@%s' % (
                    ssh.get('remote_port') or '-',
                    CREG.ssh_user_display(ssh),
                    public_ip or 'host',
                ))
            else:
                print('  legacy / unspecified')
        for _sid, rdp in rdp_items:
            print('  mstsc /v:%s:%s' % (
                public_ip or 'host',
                rdp.get('remote_port') or '-',
            ))
            print('  %s:%s' % (public_ip or 'host', rdp.get('remote_port') or '-'))

def print_tags():
    if not tags:
        print('(no tags)')
        return
    print('%-12s %s' % ('KEY', 'VALUE'))
    for key in sorted(tags):
        print('%-12s %s' % (
            CREG.sanitize_display(key, 12),
            CREG.sanitize_display(tags.get(key), 64),
        ))


def print_groups():
    rows = []
    for gid, group in manual_groups:
        rows.append((
            CREG.sanitize_display(group.get('name') or gid, 24),
            'manual',
            CREG.sanitize_display(gid, 14),
        ))
    for gid, group in dynamic_groups:
        rows.append((
            CREG.sanitize_display(group.get('name') or gid, 24),
            'dynamic',
            CREG.sanitize_display(gid, 14),
        ))
    if not rows:
        print('(none)')
        if CREG.client_is_ungrouped(state, client):
            print('System view: ungrouped')
        return
    print('%-24s %-8s %s' % ('GROUP', 'TYPE', 'GROUP ID'))
    for name, gtype, gid in rows:
        print('%-24s %-8s %s' % (name, gtype, gid))


if view == 'overview':
    print_overview()
elif view == 'services':
    print_services()
elif view == 'tags':
    print_tags()
else:
    print_groups()
