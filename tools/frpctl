}

# Read-only hostname list from the local registry. Never prints secret fields.
frpctl_registry_client_names() {
  local cfg root
  cfg="$(frpctl_path /etc/frp-auto-deploy/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  python3 - "$cfg" "$root" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
if not cfg_path.is_file():
    raise SystemExit(0)
try:
    cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(cfg, dict):
    raise SystemExit(0)
reg = Path(str(cfg.get('registry_file') or ''))
if not str(reg):
    raise SystemExit(0)
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
if not reg.is_file():
    raise SystemExit(0)
try:
    state = json.loads(reg.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(state, dict):
    raise SystemExit(0)
names = []
for client in (state.get('clients') or {}).values():
    if not isinstance(client, dict):
        continue
    host = str(client.get('hostname') or '').strip()
    label = str(client.get('label') or '').strip()
    if host and '\n' not in host and '\r' not in host:
        names.append(host)
    if label and '\n' not in label and '\r' not in label:
        names.append(label)
for name in sorted(set(names)):
    print(name)
PY
}

# Read-only service IDs for one client. Never prints secret fields.
frpctl_registry_service_ids() {
  local query="$1"
  local cfg root
  [[ -n "$query" ]] || return 0
  cfg="$(frpctl_path /etc/frp-auto-deploy/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  python3 - "$cfg" "$root" "$query" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
query = sys.argv[3]
if not cfg_path.is_file():
    raise SystemExit(0)
try:
    cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(cfg, dict):
    raise SystemExit(0)
reg = Path(str(cfg.get('registry_file') or ''))
if not str(reg):
    raise SystemExit(0)
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
if not reg.is_file():
    raise SystemExit(0)
try:
    state = json.loads(reg.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(state, dict):
    raise SystemExit(0)
matches = []
for mid, client in (state.get('clients') or {}).items():
    if not isinstance(client, dict):
        continue
    host = str(client.get('hostname') or '')
    label = str(client.get('label') or '')
    if host == query or label == query or mid == query or str(mid).startswith(query):
        matches.append(client)
if len(matches) != 1:
    raise SystemExit(0)
services = matches[0].get('services') or {}
if not isinstance(services, dict):
    raise SystemExit(0)
for sid in sorted(services):
    sid = str(sid)
    if sid and '\n' not in sid and '\r' not in sid:
        print(sid)
PY
}

frpctl_complete_arg_stage() {
  local cmd="$1" argn="$2"
  case "$cmd" in
    doctor)
      if [[ "$argn" == "1" ]]; then
        printf '%s' "doctor-flag"
      else
        printf '%s' "none"
      fi
      ;;
    enroll|create-client)
      printf '%s' "create-client-flag"
      ;;
    client|client-info|revoke|revoke-client|release-client)
      if [[ "$argn" == "1" ]]; then
        printf '%s' "client"
      else
        printf '%s' "none"
      fi
      ;;
    client-set|edit-client)
      if [[ "$argn" == "1" ]]; then
        printf '%s' "client"
      else
        printf '%s' "client-set-flag"
      fi
      ;;
    release-service)
      if [[ "$argn" == "1" ]]; then
        printf '%s' "client"
      elif [[ "$argn" == "2" ]]; then
        printf '%s' "service"
      else
        printf '%s' "none"
      fi
      ;;
    *)
      printf '%s' "none"
      ;;
  esac
}

frpctl_complete_context() {
  local line="$1"
  local trailing=0 lastc
  local -a words=()
  _FRP_CTL_COMP_CMD=""
  _FRP_CTL_COMP_PREFIX=""
  _FRP_CTL_COMP_STAGE="command"
  _FRP_CTL_COMP_CLIENT=""
  if [[ -n "$line" ]]; then
    lastc="${line: -1}"
    if [[ "$lastc" == " " || "$lastc" == $'\t' ]]; then
      trailing=1
    fi
  fi
  if [[ -n "${line//[[:space:]]/}" ]]; then
    IFS=$' \t' read -r -a words <<< "$line" || true
  fi
  if [[ ${#words[@]} -eq 0 ]]; then
    return 0
  fi
  case "${words[0]}" in
    '!'*|shell|exec|bash|sh|system)
      _FRP_CTL_COMP_STAGE="none"
      _FRP_CTL_COMP_PREFIX="${words[0]}"
      return 0
      ;;
  esac
  if [[ ${#words[@]} -eq 1 && "$trailing" == "0" ]]; then
    _FRP_CTL_COMP_PREFIX="${words[0]}"
    return 0
  fi
  _FRP_CTL_COMP_CMD="${words[0]}"
  if [[ "$trailing" == "1" ]]; then
    _FRP_CTL_COMP_PREFIX=""
    _FRP_CTL_COMP_STAGE="$(frpctl_complete_arg_stage "${_FRP_CTL_COMP_CMD}" "${#words[@]}")"
    if [[ ${#words[@]} -ge 2 ]]; then
      _FRP_CTL_COMP_CLIENT="${words[1]}"
    fi
    return 0
  fi
  _FRP_CTL_COMP_PREFIX="${words[$((${#words[@]} - 1))]}"
  _FRP_CTL_COMP_STAGE="$(frpctl_complete_arg_stage "${_FRP_CTL_COMP_CMD}" "$((${#words[@]} - 1))")"
  if [[ ${#words[@]} -ge 3 ]]; then
    _FRP_CTL_COMP_CLIENT="${words[1]}"
  fi
}

frpctl_filter_prefix() {
  local prefix="$1" item
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    if [[ "$item" == "$prefix"* ]]; then
      printf '%s\n' "$item"
    fi
  done
}

# Print matching completion candidates, one per line, sorted uniquely.
frpctl_completion_candidates() {
  local line="$1"
  frpctl_complete_context "$line"
  case "${_FRP_CTL_COMP_STAGE}" in
    command)
      frpctl_completable_commands | sort -u | frpctl_filter_prefix "${_FRP_CTL_COMP_PREFIX}"
      ;;
    doctor-flag)
      printf '%s\n' --json --verbose --quiet | frpctl_filter_prefix "${_FRP_CTL_COMP_PREFIX}"
      ;;
    create-client-flag)
      printf '%s\n' --one-line --ssh --ssh-user --ssh-port --ttl --note --client-name --label --services-file \
        | frpctl_filter_prefix "${_FRP_CTL_COMP_PREFIX}"
      ;;
    client-set-flag)
      printf '%s\n' --label --note | frpctl_filter_prefix "${_FRP_CTL_COMP_PREFIX}"
      ;;
    client)
      if ! frpctl_is_server; then
        return 0
      fi
      frpctl_registry_client_names | sort -u | frpctl_filter_prefix "${_FRP_CTL_COMP_PREFIX}"
      ;;
    service)
      if ! frpctl_is_server; then
        return 0
      fi
      frpctl_registry_service_ids "${_FRP_CTL_COMP_CLIENT}" | sort -u | frpctl_filter_prefix "${_FRP_CTL_COMP_PREFIX}"
      ;;
    *)
      return 0
      ;;
  esac
}

frpctl_common_prefix() {
  local prefix="$1"
  shift || true
  local s
  [[ $# -gt 0 ]] || { printf '%s' "$prefix"; return 0; }
  for s in "$@"; do
    while [[ -n "$prefix" && "$s" != "$prefix"* ]]; do
      prefix="${prefix%?}"
    done
  done
  printf '%s' "$prefix"
}

frpctl_line_with_token() {
  local line="$1"
  local token="$2"
  local add_space="${3:-1}"
  local trailing=0 lastc i
  local -a words=()
  local new=""
  if [[ -n "$line" ]]; then
    lastc="${line: -1}"
    if [[ "$lastc" == " " || "$lastc" == $'\t' ]]; then
      trailing=1
    fi
  fi
  if [[ -n "${line//[[:space:]]/}" ]]; then
    IFS=$' \t' read -r -a words <<< "$line" || true
  fi
  if [[ ${#words[@]} -eq 0 || ( ${#words[@]} -eq 1 && "$trailing" == "0" ) ]]; then
    new="$token"
  elif [[ "$trailing" == "1" ]]; then
    new="${line%"${line##*[![:space:]]}"}"
    new="${new} ${token}"
  else
    new="${words[0]}"
    if [[ ${#words[@]} -gt 1 ]]; then
      for (( i=1; i<${#words[@]}-1; i++ )); do
        new+=" ${words[i]}"
      done
      new+=" ${token}"
    fi
  fi
  if [[ "$add_space" == "1" ]]; then
    new+=" "
  fi
  printf '%s' "$new"
}

# Apply unique/common-prefix completion. Prints the resulting line.
frpctl_complete_line() {
  local line="$1"
  local -a cands=()
  local shared
  mapfile -t cands < <(frpctl_completion_candidates "$line")
  if [[ ${#cands[@]} -eq 0 ]]; then
    printf '%s' "$line"
    return 0
  fi
  if [[ ${#cands[@]} -eq 1 ]]; then
    frpctl_line_with_token "$line" "${cands[0]}" 1
    return 0
  fi
  shared="$(frpctl_common_prefix "${cands[0]}" "${cands[@]}")"
  frpctl_complete_context "$line"
  if [[ -n "$shared" && "$shared" != "${_FRP_CTL_COMP_PREFIX}" ]]; then
    frpctl_line_with_token "$line" "$shared" 0
    return 0
  fi
  printf '%s' "$line"
}

frpctl_readline_complete() {
  local line="${READLINE_LINE-}"
  local point="${READLINE_POINT-0}"
  local -a cands=()
  local new=""
  if [[ "$point" != "${#line}" ]]; then
    return 0
  fi
  mapfile -t cands < <(frpctl_completion_candidates "$line" || true)
  if [[ ${#cands[@]} -eq 0 ]]; then
    return 0
  fi
  if [[ ${#cands[@]} -eq 1 ]]; then
    new="$(frpctl_complete_line "$line")"
    READLINE_LINE="$new"
    READLINE_POINT=${#READLINE_LINE}
    return 0
  fi
  new="$(frpctl_complete_line "$line")"
  READLINE_LINE="$new"
  READLINE_POINT=${#READLINE_LINE}
  printf '\n' >&2
  printf '%s' "${cands[0]}" >&2
  local c
  for c in "${cands[@]:1}"; do
    printf '  %s' "$c" >&2
  done
  printf '\n' >&2
  return 0
}

frpctl_repl_enable_completion() {
  set +o history 2>/dev/null || true
  unset HISTFILE
  _FRP_CTL_BOUND_TAB=""
  # Custom Tab only. If bind -x is unavailable, keep using read without -e so
  # Bash filename completion cannot become the fallback.
  if [[ "${FRP_CTL_DISABLE_TAB:-}" == "1" ]]; then
    return 0
  fi
  if (( BASH_VERSINFO[0] < 4 )); then
    return 0
  fi
  if bind -x '"\t": frpctl_readline_complete' 2>/dev/null; then
    bind 'set disable-completion on' 2>/dev/null || true
    _FRP_CTL_BOUND_TAB=1
  fi
}

frpctl_repl_disable_completion() {
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    bind -r '\t' 2>/dev/null || true
  fi
  _FRP_CTL_BOUND_TAB=""
}

frpctl_edit_distance() {
  python3 - "$1" "$2" <<'PY'
import sys
a, b = sys.argv[1], sys.argv[2]
la, lb = len(a), len(b)
if abs(la - lb) > 3:
    print(99)
    raise SystemExit(0)
prev = list(range(lb + 1))
for i, ca in enumerate(a, 1):
    cur = [i]
    for j, cb in enumerate(b, 1):
        ins, delete, sub = cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + (ca != cb)
        cur.append(min(ins, delete, sub))
    prev = cur
print(prev[-1])
PY
}

frpctl_suggest() {
  local unknown="$1"
  local cmd dist
  local -a suggestions=()
  [[ -n "$unknown" ]] || return 0
  while IFS= read -r cmd; do
    [[ -n "$cmd" ]] || continue
    [[ "$cmd" != "?" ]] || continue
    if [[ ${#unknown} -ge 3 && "$cmd" == "$unknown"* ]]; then
      suggestions+=("$cmd")
      continue
    fi
    if [[ ${#cmd} -ge 3 && "$unknown" == "$cmd"* ]]; then
      suggestions+=("$cmd")
      continue
    fi
    dist="$(frpctl_edit_distance "$unknown" "$cmd" 2>/dev/null || echo 99)"
    if [[ "$dist" =~ ^[0-9]+$ ]] && [[ "$dist" -ge 1 && "$dist" -le 2 ]]; then
      suggestions+=("$cmd")
    fi
  done < <(frpctl_known_commands | sort -u)
  if [[ ${#suggestions[@]} -eq 0 ]]; then
    return 0
  fi
  echo "Did you mean:"
  local seen="" s
  for s in "${suggestions[@]}"; do
    case " $seen " in
      *" $s "*) continue ;;
    esac
    echo "  $s"
    seen="${seen} ${s}"
  done
  echo
}

frpctl_unknown_command() {
  local cmd="$1"
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    echo "Unknown command: ${cmd}" >&2
    echo >&2
    frpctl_suggest "$cmd" >&2
    echo "Type 'help' for available commands." >&2
    return 0
  fi
  echo "ERROR: unknown command: ${cmd}" >&2
  echo >&2
  frpctl_usage >&2
  return 2
}

frpctl_reject_shell() {
  echo "ERROR: arbitrary shell execution is not allowed." >&2
  echo "frpctl is not a general-purpose shell. Type 'help' for commands." >&2
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    return 0
  fi
  return 2
}

frpctl_dispatch() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    -h|--help)
      frpctl_usage
      ;;
    help|'?')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        frpctl_repl_help
      else
        frpctl_usage
      fi
      ;;
    menu)
      frpctl_interactive
      ;;
    status)
      frpctl_status "$@"
      ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frp_doctor_main "$@"
      ;;
    client-status)
      frpctl_require_client || return 1
      frpctl_run frp-client status "$@"
      ;;
    server-status)
      frpctl_require_server || return 1
      frpctl_run frp-server-status "$@"
      ;;
    version)
      echo
      frpctl_print_version
      echo
      ;;
    update)
      frpctl_update "$@"
      ;;
    client-update)
      frpctl_require_client || return 1
      frpctl_client_update "$@"
      ;;
    server-update)
      frpctl_require_server || return 1
      frpctl_run frp-update "$@"
      ;;
    clear)
      frpctl_clear_screen
      ;;
    exit|quit|q)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
        return 0
      fi
      return 0
      ;;
    manage)
      frpctl_require_client || return 1
      frpctl_invoke frp-client "$@"
      ;;
    services)
      frpctl_require_client || return 1
      frpctl_invoke frp-client list "$@"
      ;;
    info)
      frpctl_require_client || return 1
      frpctl_invoke frp-client info "$@"
      ;;
    clients)
      frpctl_require_server || return 1
      frpctl_invoke frp-clients "$@"
      ;;
    enroll|create-client)
      frpctl_require_server || return 1
      frpctl_invoke frp-create-client "$@"
      ;;
    client|client-info)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "client" ]]; then
          frpctl_usage_error "client <name>"
        else
          frpctl_usage_error "frpctl client-info <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-client-info "$@"
      ;;
    client-set|edit-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "client-set <client> [--label NAME] [--note TEXT]"
        else
          frpctl_usage_error "frpctl client-set <client> [--label NAME] [--note TEXT]"
        fi
        return $?
      fi
      frpctl_invoke frp-client-set "$@"
      ;;
    revoke|revoke-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "revoke" ]]; then
          frpctl_usage_error "revoke <name>"
        else
          frpctl_usage_error "frpctl revoke-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-revoke-client "$@"
      ;;
    release-service)
      frpctl_require_server || return 1
      if [[ $# -lt 2 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-service <client> <service-id>"
        else
          frpctl_usage_error "frpctl release-service <client> <service-id>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-service "$@"
      ;;
    release-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-client <client>"
        else
          frpctl_usage_error "frpctl release-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-client "$@"
      ;;
    shell|exec|bash|sh|system)
      frpctl_reject_shell
      ;;
    '!'*|\!*)
      frpctl_reject_shell
      ;;
    '')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        return 0
      fi
      frpctl_repl
      ;;
    *)
      frpctl_unknown_command "$cmd"
      ;;
  esac
}

frpctl_tokenize() {
  local line="$1"
  _FRP_CTL_TOKENS=()
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n "$line" ]] || return 0
  # Whitespace-delimited tokens only. Do not eval, glob, or expand.
  IFS=$' \t' read -r -a _FRP_CTL_TOKENS <<< "$line" || true
}

frpctl_repl_sigint() {
  _FRP_CTL_SIGINT=1
}

frpctl_repl_banner() {
  echo "FRP Auto Deploy CLI"
  echo "==================="
  echo
  echo "Role            : $(frpctl_role_label)"
  echo "Project version : $(frpctl_project_version)"
  echo "Release channel : $(frpctl_release_channel)"
  echo "Source ref      : $(frpctl_source_ref)"
  echo "FRP version     : $(frpctl_frp_version)"
  echo "Bundle SHA256   : $(frpctl_bundle_sha256)"
  echo
  echo "Type 'help' or '?' for available commands."
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" || -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    echo "Press Tab to complete commands."
    echo "On a server, Tab also completes client names and service IDs."
  else
    echo "Tab completion is unavailable on this shell; type commands in full."
  fi
  echo "Type 'menu' for the guided menu."
  echo "Type 'exit' to leave."
  echo
}

frpctl_repl_read_line() {
  _FRP_CTL_LINE=""
  frpctl_input_init
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    printf 'frpctl> '
    if ! IFS= read -r _FRP_CTL_LINE <&9; then
      return 1
    fi
    printf '%s\n' "$_FRP_CTL_LINE"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "ERROR: interactive frpctl requires a TTY." >&2
    echo "Use: frpctl <command>" >&2
    return 1
  fi
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    if ! IFS= read -e -r -p "frpctl> " _FRP_CTL_LINE; then
      return 1
    fi
  else
    # No readline: Tab is a literal character, not filesystem completion.
    printf 'frpctl> '
    if ! IFS= read -r _FRP_CTL_LINE; then
      return 1
    fi
  fi
  return 0
}

frpctl_repl() {
  local rc
  frpctl_require_install || return 1
  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && ! -t 0 ]]; then
    echo "ERROR: interactive frpctl requires a TTY." >&2
    echo "Use: frpctl <command>" >&2
    return 1
  fi

  # In-memory interaction only. Do not persist command history.
  unset HISTFILE
  set +o history 2>/dev/null || true
  FRP_CTL_REPL=1
  _FRP_CTL_SHOULD_EXIT=0
  _FRP_CTL_SIGINT=0
  _FRP_CTL_BOUND_TAB=""
  trap 'frpctl_repl_sigint' INT

  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && -t 0 ]]; then
    frpctl_repl_enable_completion
  fi

  frpctl_repl_banner

  while true; do
    _FRP_CTL_SIGINT=0
    _FRP_CTL_LINE=""
    if ! frpctl_repl_read_line; then
      if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
        echo
        continue
      fi
      echo
      break
    fi
    if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
      echo
      continue
    fi
    frpctl_tokenize "$_FRP_CTL_LINE"
    if [[ ${#_FRP_CTL_TOKENS[@]} -eq 0 ]]; then
      continue
    fi
    case "${_FRP_CTL_TOKENS[0]}" in
      '!'*|shell|exec|bash|sh|system)
        frpctl_reject_shell || true
        continue
        ;;
    esac
    rc=0
    frpctl_dispatch "${_FRP_CTL_TOKENS[@]}" || rc=$?
    if [[ "${_FRP_CTL_SHOULD_EXIT}" == "1" ]]; then
      break
    fi
    if [[ "$rc" -ne 0 && "$rc" -ne 130 ]]; then
      echo
      echo "Command failed with exit code ${rc}."
      echo
    fi
  done

  trap - INT
  frpctl_repl_disable_completion
  frpctl_input_cleanup
  FRP_CTL_REPL=0
  return 0
}

frpctl_main() {
  local cmd="${1:-}"
  case "$cmd" in
    '')
      frpctl_repl
      ;;
    *)
      frpctl_dispatch "$@"
      ;;
  esac
}

if [[ "${FRP_CTL_SOURCED:-}" != "1" ]]; then
  frpctl_main "$@"
fi
