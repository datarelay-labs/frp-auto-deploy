#!/usr/bin/env bash
# Operator status for an frp-auto-deploy server.
# Default mode never exits non-zero for missing binaries, config, or upstream lookup failures.
# --check exits non-zero when the server is not ready for registry schema v2.
set -uo pipefail

CHECK_ONLY=0
if [[ "${1:-}" == "--check" ]]; then
  CHECK_ONLY=1
fi

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_SCRIPT_DIR}/../lib/frp-common.sh" ]]; then
  # shellcheck source=../lib/frp-common.sh
  . "${_SCRIPT_DIR}/../lib/frp-common.sh"
elif [[ -f /usr/local/lib/frp-auto-deploy/frp-common.sh ]]; then
  # shellcheck disable=SC1091
  . /usr/local/lib/frp-auto-deploy/frp-common.sh
fi

if type frp_path >/dev/null 2>&1; then
  frps_bin="$(frp_path /usr/local/bin/frps)"
  version_file="$(frp_path /etc/frp-auto-deploy/version)"
  config_file="$(frp_path /etc/frp-auto-deploy/config.json)"
  registry_file="$(frp_path /var/lib/frp-auto-deploy/registry.json)"
else
  frps_bin=/usr/local/bin/frps
  version_file=/etc/frp-auto-deploy/version
  config_file=/etc/frp-auto-deploy/config.json
  registry_file=/var/lib/frp-auto-deploy/registry.json
fi

project_version="unknown"
tested_frp="${FRP_VERSION:-unknown}"
release_channel="unknown"
source_ref="unknown"
bundle_sha256="unknown"
if [[ -f "$version_file" ]] && type frp_read_kv_file >/dev/null 2>&1; then
  _pv="$(frp_read_kv_file "$version_file" PROJECT_VERSION)"
  _tv="$(frp_read_kv_file "$version_file" FRP_VERSION)"
  _ch="$(frp_read_kv_file "$version_file" RELEASE_CHANNEL)"
  _ref="$(frp_read_kv_file "$version_file" SOURCE_REF)"
  _sha="$(frp_read_kv_file "$version_file" BUNDLE_SHA256)"
  [[ -n "${_pv:-}" ]] && project_version="$_pv"
  [[ -n "${_tv:-}" ]] && tested_frp="$_tv"
  [[ -n "${_ch:-}" ]] && release_channel="$_ch"
  [[ -n "${_ref:-}" ]] && source_ref="$_ref"
  [[ -n "${_sha:-}" ]] && bundle_sha256="$_sha"
fi

installed_frp="unknown"
if type frp_parse_binary_version >/dev/null 2>&1; then
  installed_frp="$(frp_parse_binary_version "$frps_bin")"
fi
[[ -n "${installed_frp:-}" ]] || installed_frp="unknown"

upstream_latest="unavailable"
if type frp_upstream_latest >/dev/null 2>&1; then
  upstream_latest="$(frp_upstream_latest)"
fi
[[ -n "${upstream_latest:-}" ]] || upstream_latest="unavailable"

update_status="unknown"
if [[ "$installed_frp" == "unknown" || "$tested_frp" == "unknown" ]]; then
  update_status="unknown"
elif [[ "$installed_frp" == "$tested_frp" ]]; then
  if [[ "$upstream_latest" != "unavailable" && "$upstream_latest" != "$tested_frp" ]]; then
    update_status="up to date (tested version)"
  else
    update_status="up to date"
  fi
else
  update_status="update available"
fi

unit_state() {
  local unit="$1" state=""
  if type frp_test_harness_enabled >/dev/null 2>&1 && frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_SKIP_SYSTEMD:-}" == "1" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1; then
    state="$(systemctl is-active "$unit" 2>/dev/null || true)"
  fi
  [[ -n "$state" ]] || state="unknown"
  printf '%s' "$state"
}

frps_state="$(unit_state frps)"
allocator_state="$(unit_state frp-port-allocator)"
frontend_state="$(unit_state frp-frontend)"

host_role="Server"
if type frp_detect_host_role >/dev/null 2>&1; then
  frp_detect_host_role
  case "${FRP_HOST_ROLE:-}" in
    both) host_role="Server + Client" ;;
    client) host_role="Client" ;;
    server) host_role="Server" ;;
    partial-server) host_role="Partial server installation" ;;
    partial-client) host_role="Partial client installation" ;;
  esac
fi

control_port=""
control_listen_port=""
port_start=""
port_end=""
allocator_port=""
allocator_public=""
public_host=""
allocator_url=""
ca_fingerprint=""
deployment_mode=""
frp_transport=""
control_bind=""
allocator_bind=""
if [[ -r "$config_file" ]]; then
  eval "$(python3 - "$config_file" <<'PY'
import json, shlex, sys, base64, hashlib
from pathlib import Path

def coerce_port(value):
    try:
        port = int(value)
    except (TypeError, ValueError):
        return None
    return port if 1 <= port <= 65535 else None

def fingerprint(path):
    try:
        text = Path(path).read_text(encoding='utf-8')
    except OSError:
        return ''
    if '-----BEGIN CERTIFICATE-----' not in text:
        return ''
    lines = []
    in_body = False
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith('-----BEGIN'):
            in_body = True
            continue
        if line.startswith('-----END'):
            break
        if in_body:
            lines.append(line)
    if not lines:
        return ''
    try:
        der = base64.b64decode(''.join(lines))
    except Exception:
        return ''
    return hashlib.sha256(der).hexdigest()

try:
    cfg = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)
if not isinstance(cfg, dict):
    raise SystemExit(0)
host = cfg.get('public_host') or cfg.get('public_ip')
if host:
    print('public_host=' + shlex.quote(str(host)))
public_port = coerce_port(cfg.get('frp_control_public_port')) or coerce_port(cfg.get('control_port'))
listen_port = coerce_port(cfg.get('frp_control_listen_port')) or coerce_port(cfg.get('control_port'))
if public_port is not None:
    print('control_port=' + shlex.quote(str(public_port)))
if listen_port is not None:
    print('control_listen_port=' + shlex.quote(str(listen_port)))
for key, envname in (
    ("port_start", "port_start"),
    ("port_end", "port_end"),
    ("allocator_public_url", "allocator_url"),
):
    value = cfg.get(key)
    if value is None or value == "":
        continue
    print(f"{envname}={shlex.quote(str(value))}")
alloc_listen = coerce_port(cfg.get('allocator_listen_port')) or coerce_port(cfg.get('listen_port'))
alloc_public = coerce_port(cfg.get('allocator_public_port'))
if alloc_listen is not None:
    print('allocator_port=' + shlex.quote(str(alloc_listen)))
if alloc_public is not None:
    print('allocator_public=' + shlex.quote(str(alloc_public)))
root = Path(sys.argv[1]).parent
ca = cfg.get('tls_ca_cert') or str(root / 'pki' / 'ca.crt')
fp = fingerprint(ca)
if fp:
    print('ca_fingerprint=' + shlex.quote(fp))
mode = str(cfg.get('deployment_mode') or 'direct').strip().lower()
compact = mode.replace('-', '').replace('_', '')
if compact in ('single443', 'enterprise', 'enterprisesingle443'):
    mode = 'single443'
else:
    mode = 'direct'
print('deployment_mode=' + shlex.quote(mode))
transport = str(cfg.get('frp_transport') or '').strip().lower()
if not transport:
    transport = 'wss' if mode == 'single443' else 'tcp'
print('frp_transport=' + shlex.quote(transport))
bind = str(cfg.get('frp_control_bind_addr') or cfg.get('listen_host') or '')
if bind:
    print('control_bind=' + shlex.quote(bind))
listen_host = str(cfg.get('listen_host') or '')
if listen_host:
    print('allocator_bind=' + shlex.quote(listen_host))
PY
)" 2>/dev/null || true
fi

public_host_state="missing"
if [[ -n "${public_host:-}" ]]; then
  public_host_state="configured"
fi
allocator_url_state="missing"
if [[ -n "${allocator_url:-}" ]]; then
  allocator_url_state="configured"
fi

registry_schema="none"
registry_state="missing"
if type frp_registry_readiness >/dev/null 2>&1; then
  readiness="$(frp_registry_readiness "$registry_file" 2>/dev/null || true)"
  if [[ -n "$readiness" ]]; then
    registry_schema="$(printf '%s\n' "$readiness" | sed -n '1p')"
    registry_state="$(printf '%s\n' "$readiness" | sed -n '2p')"
  fi
fi
[[ -n "$registry_schema" ]] || registry_schema="none"
[[ -n "$registry_state" ]] || registry_state="missing"

clients="0"
reserved="0"
if type frp_registry_counts >/dev/null 2>&1 && [[ -r "$registry_file" ]]; then
  counts="$(frp_registry_counts "$registry_file" 2>/dev/null || echo "0 0")"
  clients="${counts%% *}"
  reserved="${counts##* }"
fi

lifecycle="consistent"
last_failure=""
pending_file=""
if type frp_txn_marker_path >/dev/null 2>&1; then
  pending_file="$(frp_txn_marker_path)"
elif type frp_path >/dev/null 2>&1; then
  pending_file="$(frp_path /var/lib/frp-auto-deploy/update-pending.json)"
else
  pending_file=/var/lib/frp-auto-deploy/update-pending.json
fi
if [[ -f "$pending_file" ]]; then
  lifecycle="RECOVERY_REQUIRED"
  eval "$(python3 - "$pending_file" <<'PY'
import json, shlex, sys
from pathlib import Path
try:
    data = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
phase = data.get('phase') or 'unknown'
op = data.get('operation') or ''
fail = data.get('failure_class') or data.get('FAILURE_CLASS') or ''
print('pending_phase=' + shlex.quote(str(phase)))
print('pending_op=' + shlex.quote(str(op)))
if fail:
    print('last_failure=' + shlex.quote(str(fail)))
PY
)" 2>/dev/null || true
fi

cat <<EOF
FRP Auto Deploy
===============

Role            : ${host_role}
Project version : ${project_version}
Release channel : ${release_channel}
Source ref      : ${source_ref}
Installed FRP   : ${installed_frp}
Tested FRP      : ${tested_frp}
Bundle SHA256   : ${bundle_sha256}
Upstream latest : ${upstream_latest}
Update status   : ${update_status}

Registry schema : ${registry_schema}
Registry state  : ${registry_state}
Allocator URL   : ${allocator_url_state}
Public host     : ${public_host_state}

frps            : ${frps_state}
allocator       : ${allocator_state}
frontend        : ${frontend_state}
Lifecycle       : ${lifecycle}
EOF

if [[ -n "${last_failure:-}" ]]; then
  echo "Last failure    : ${last_failure}"
  echo "Recovery required : yes"
fi
if [[ -n "${pending_phase:-}" ]]; then
  echo "Pending phase   : ${pending_phase}"
fi

if [[ "$registry_state" == "incompatible" || "$registry_state" == "invalid" ]]; then
  echo "Action required : backup/reset/redeploy before using generic multi-service enrollment"
  echo "See docs/SCHEMA_V2_DEPLOYMENT.md"
fi

if [[ -n "${control_port:-}" ]]; then
  echo
  echo "Deployment mode : ${deployment_mode:-direct}"
  echo
  echo "FRP control"
  echo "  Public endpoint : ${public_host:-unknown}:${control_port}"
  echo "  Transport       : ${frp_transport:-tcp}"
  echo "  Local listener  : ${control_bind:-0.0.0.0}:${control_listen_port:-$control_port}"
  echo "FRP public      : TCP/${control_port}"
  if [[ -n "${control_listen_port:-}" && "${control_listen_port}" != "${control_port}" ]]; then
    echo "FRP listen      : TCP/${control_listen_port}"
  else
    echo "FRP listen      : TCP/${control_listen_port:-$control_port}"
  fi
  echo "Service range   : TCP/${port_start}-${port_end}"
  echo
  echo "Allocator"
  if [[ -n "${allocator_url:-}" ]]; then
    echo "  Public endpoint : ${allocator_url}"
    echo "Allocator URL   : ${allocator_url}"
  fi
  echo "  Local listener  : ${allocator_bind:-0.0.0.0}:${allocator_port}"
  echo "Allocator listen: TCP/${allocator_port}"
  if [[ -n "${allocator_public:-}" && "${allocator_public}" != "${allocator_port}" ]]; then
    echo "Allocator public: TCP/${allocator_public}"
  fi
  if [[ -n "${ca_fingerprint:-}" ]]; then
    echo "TLS CA SHA256   : ${ca_fingerprint}"
  fi
fi

echo
echo "Clients         : ${clients}"
echo "Reserved ports  : ${reserved}"

if [[ "$CHECK_ONLY" == "1" ]]; then
  if [[ "$registry_state" == "ready" && "$public_host_state" == "configured" && "$allocator_url_state" == "configured" ]]; then
    exit 0
  fi
  exit 1
fi
exit 0
