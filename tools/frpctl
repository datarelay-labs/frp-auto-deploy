    echo "Remote access control"
    echo "===================="
    frpctl_print_client_remote_menu
    echo
    choice="$(frpctl_read "Select: " "")" || return 1
    case "$choice" in
      1) frpctl_lifecycle_dispatch pause ;;
      2) frpctl_lifecycle_dispatch resume ;;
      3) frpctl_lifecycle_dispatch restart ;;
      4) return 0 ;;
      *) echo "ERROR: select 1-4" >&2 ;;
    esac
  done
}

frpctl_lifecycle_dispatch() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    pause) frp_client_pause_remote_access "$@" ;;
    resume) frp_client_resume_remote_access "$@" ;;
    restart) frp_client_lifecycle_restart "$@" ;;
    test) frp_client_lifecycle_test "$@" ;;
    logs) frp_client_lifecycle_logs "$@" ;;
    support-bundle) frp_client_lifecycle_support_bundle "$@" ;;
    uninstall) frp_client_lifecycle_uninstall "$@" ;;
    *)
      echo "ERROR: unknown lifecycle command: $cmd" >&2
      return 1
      ;;
  esac
}

